@@ -0,0 +1,64 @@
+.skill-check-dialog {
+  .skill-check-header {
+    display: flex;
+    flex-direction: column;
+    margin-bottom: 8px;
+
+    .skill-name {
+      font-weight: bold;
+      font-size: 1.1em;
+    }
+
+    .skill-level,
+    .skill-flat-modifier {
+      font-size: 0.9em;
+      opacity: 0.8;
+    }
+  }
+
+  .override-hint {
+    font-size: 0.8em;
+    font-style: italic;
+    opacity: 0.8;
+    margin: 4px 0 0;
+  }
+
+  .modifiers {
+    list-style: none;
+    margin: 8px 0;
+    padding: 0;
+
+    li {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      padding: 2px 0;
+
+      .mod-label {
+        flex: 1;
+      }
+
+      .mod-value {
+        margin: 0 8px;
+      }
+    }
+  }
+
+  .add-modifier-row {
+    display: flex;
+    gap: 4px;
+    margin-bottom: 8px;
+
+    .mod-name {
+      flex: 2;
+    }
+
+    .mod-value {
+      flex: 1;
+    }
+  }
+
+  footer button[type="submit"] {
+    width: 100%;
+  }
+}
