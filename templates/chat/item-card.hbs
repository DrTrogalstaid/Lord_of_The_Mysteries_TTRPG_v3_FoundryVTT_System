{{!-- An item sent to chat from a sheet (sheets/base-actor-sheet.mjs): its picture, name and description. The
      description is already HTML (enriched). --}}
<div class="lotm chat-item">
  <header class="chat-item-header"><img src="{{img}}" width="36" height="36" alt=""><h3>{{name}}</h3></header>
  <div class="chat-item-description">{{lotmHTML description}}</div>
</div>
