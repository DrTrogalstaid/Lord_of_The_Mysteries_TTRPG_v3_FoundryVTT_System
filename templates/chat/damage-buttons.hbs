{{!-- Under an action's attack roll: Roll Damage, then Big Success (helpers/action-roll.mjs damageButtonHTML). --}}
<div class="lotm-damage-buttons">
  <button type="button" class="lotm-roll-damage" data-lotm-action="damage">{{lotmLang "LORD_OF_THE_MYSTERIES.Action.RollDamage"}}</button>
  <button type="button" class="lotm-roll-damage big-success" data-lotm-action="bigSuccess" data-tooltip="{{localize "LORD_OF_THE_MYSTERIES.Action.BigSuccessHint"}}">{{lotmLang "LORD_OF_THE_MYSTERIES.Action.BigSuccess"}}</button>
</div>
