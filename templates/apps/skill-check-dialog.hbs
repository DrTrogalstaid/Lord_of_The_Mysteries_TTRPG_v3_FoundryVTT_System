{{!-- SkillCheckDialog (module/apps/skill-check-dialog.mjs). The modifiers, Spirituality, who-sees-it buttons and
      Roll button are the shared roll dialog partials (templates/apps/roll-dialog/). --}}
<div class="skill-check-dialog-content">
    <header class="skill-check-header">
        {{!-- Only when rolling an action (e.g. a revolver's "Shoot"): its name and the dice it rolls. --}}
        {{#if actionName}}
        <span class="skill-check-action">{{actionName}}</span>
        {{/if}}
        <span class="skill-name">{{skillName}}</span>
        <span class="skill-level">{{levelLabel}} ({{numberFormat levelBonus decimals=0 sign=true}})</span>
        {{#if flatModifier}}
        <span class="skill-flat-modifier">{{localize "LORD_OF_THE_MYSTERIES.SkillCheck.ItemModifier"}} ({{numberFormat flatModifier decimals=0 sign=true}})</span>
        {{/if}}
        {{#if actionName}}
        <span class="skill-check-dice">{{localize "LORD_OF_THE_MYSTERIES.SkillCheck.ActionDice"}}: {{actionDice}}</span>
        {{/if}}
    </header>

    {{#if actionFormulaInvalid}}
    <p class="hint skill-check-formula-warning">
        <i class="fa-solid fa-triangle-exclamation"></i>
        {{localize "LORD_OF_THE_MYSTERIES.SkillCheck.InvalidActionFormulaHint"}} <code>{{actionFormula}}</code>
    </p>
    {{/if}}

    {{> "systems/lotm/templates/apps/roll-dialog/spirituality.hbs"}}

    <div class="form-group">
        <label>{{localize "LORD_OF_THE_MYSTERIES.SkillCheck.LinkedAttribute"}}</label>
        <select name="attribute">
            {{#each attributes as |a|}}
                <option value="{{a.key}}" {{#if a.selected}}selected{{/if}}>
                    {{a.label}} ({{numberFormat a.total decimals=0 sign=true}}){{#unless a.isDefault}} — {{localize "LORD_OF_THE_MYSTERIES.SkillCheck.Override"}}{{/unless}}
                </option>
            {{/each}}
        </select>
        {{#if attributeChanged}}
        <p class="hint override-hint">{{localize "LORD_OF_THE_MYSTERIES.SkillCheck.OverrideHint"}}</p>
        {{/if}}
    </div>

    <hr />
    {{> "systems/lotm/templates/apps/roll-dialog/modifiers.hbs"}}
    <hr />
    {{> "systems/lotm/templates/apps/roll-dialog/footer.hbs"}}
</div>
