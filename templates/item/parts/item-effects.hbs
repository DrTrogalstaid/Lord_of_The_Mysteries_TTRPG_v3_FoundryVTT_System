{{!-- An item's effects (the Effects tab of abilities, actions, spells and Sequences; the bottom of the gear sheet).
      Prepared in _prepareItemEffects (sheets/base-item-sheet.mjs). Rows can be dragged onto tokens or other sheets;
      effects dropped here are copied onto the item. --}}
<div class="item-effects" data-item-effects>
  <header class="item-effects-header">
    <div class="box-title">{{localize "LORD_OF_THE_MYSTERIES.Effects.List"}}</div>
    {{#if editable}}
    <button type="button" class="item-effects-create" data-action="createEffect">
      <i class="fa-solid fa-plus"></i> {{localize "LORD_OF_THE_MYSTERIES.Effects.Item.Create"}}
    </button>
    {{/if}}
  </header>

  <ol class="effect-list">
    {{#each itemEffects as |effect|}}
    <li class="effect-row{{#if effect.disabled}} inactive{{/if}}" data-effect-id="{{effect.id}}" draggable="true">
      <img class="effect-img" src="{{effect.img}}" alt="" />

      <div class="effect-info">
        <span class="effect-name">{{effect.name}}</span>
        <span class="effect-detail">{{effect.detail}}</span>
      </div>

      {{#if effect.duration}}<span class="effect-duration">{{effect.duration}}</span>{{/if}}

      <div class="effect-controls">
        {{#unless effect.passive}}
        <a class="effect-control" data-action="applyEffect" data-tooltip="{{localize 'LORD_OF_THE_MYSTERIES.Effects.Item.ApplyHint'}}">
          <i class="fa-solid fa-person-rays"></i>
        </a>
        {{/unless}}
        {{#if @root.editable}}
        <a class="effect-control" data-action="toggleEffect"
           data-tooltip="{{#if effect.disabled}}{{localize 'LORD_OF_THE_MYSTERIES.Effects.TurnOn'}}{{else}}{{localize 'LORD_OF_THE_MYSTERIES.Effects.TurnOff'}}{{/if}}">
          <i class="fa-solid {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i>
        </a>
        {{/if}}
        <a class="effect-control" data-action="editEffect" data-tooltip="{{localize 'LORD_OF_THE_MYSTERIES.Effects.Edit'}}">
          <i class="fa-solid fa-pen-to-square"></i>
        </a>
        {{#if @root.editable}}
        <a class="effect-control" data-action="deleteEffect" data-tooltip="{{localize 'LORD_OF_THE_MYSTERIES.Effects.Delete'}}">
          <i class="fa-solid fa-trash"></i>
        </a>
        {{/if}}
      </div>
    </li>
    {{else}}
    <li class="placeholder-note">{{localize "LORD_OF_THE_MYSTERIES.Effects.Item.Empty"}}</li>
    {{/each}}
  </ol>
  <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Effects.Item.Hint"}}</p>
</div>
