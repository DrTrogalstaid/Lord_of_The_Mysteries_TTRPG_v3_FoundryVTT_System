{{!-- A list of one-line texts with add / delete buttons: an action's Special Results, an ability's or spell's
      Sequence Upgrades. Saves to an array field; the buttons are addTextRow / deleteTextRow in sheets/base-item-sheet.mjs.
      Use: {{> "systems/lotm/templates/item/parts/text-rows.hbs" field="system.specialResults" rows=specialResults
              class="special-results" legend="LORD_OF_THE_MYSTERIES.ItemSheet.SpecialResults"
              placeholder="LORD_OF_THE_MYSTERIES.ItemSheet.SpecialResultPlaceholder" addLabel="LORD_OF_THE_MYSTERIES.ItemSheet.AddSpecialResult"}}
      rows: [{index, value}] (_textRows in base-item-sheet.mjs). legend, placeholder and addLabel are lang keys. --}}
<fieldset class="{{class}}">
  <legend>{{localize legend}}</legend>
  <ol class="items-list">
    {{#each rows as |row|}}
    <li class="item flexrow">
      <input type="text" class="blend-input flexlarge"
            name="{{../field}}.{{row.index}}"
            value="{{row.value}}" placeholder="{{localize ../placeholder}}" />
      <div class="item-controls">
        <a class="item-control" data-action="deleteTextRow" data-field="{{../field}}" data-index="{{row.index}}" title="{{localize 'LORD_OF_THE_MYSTERIES.ItemSheet.Delete'}}">
          <i class="fas fa-trash"></i>
        </a>
      </div>
    </li>
    {{/each}}
  </ol>
  <a class="item-control add-row" data-action="addTextRow" data-field="{{field}}">
    <i class="fas fa-plus"></i> {{localize addLabel}}
  </a>
</fieldset>
