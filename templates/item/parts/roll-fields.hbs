{{!-- How an action or spell rolls: Modifiers, Skill, Attack Roll Macro, Defense Targeted, DC, outcome tables, damage.
      The action and spell sheets both show these (RollableItemSheet in sheets/item/character_building/rollable-item-sheet.mjs,
      which also fills in rollFields: the Skill slot's hints and the Defense Targeted dropdown's blank option). --}}

      <!--Modifiers-->
      <fieldset>
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.Modifiers"}}</legend>
        <input id="modifiers" class="blend-input" type="number" name="system.modifiers" value="{{system.modifiers}}" step="1" />
      </fieldset>

      <!--Skill: the skill this rolls with (e.g. Pistol). Drop a skill here; dropping another replaces it.
          Drop handling: bindSkillSlot() in helpers/skill-slot.mjs. -->
      <fieldset class="action-skill" data-skill-slot>
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ActionSkill.Label"}}</legend>
        {{#if actionSkill}}
          <div class="action-skill-entry">
            <img src="{{actionSkill.img}}" alt="" width="24" height="24">
            {{#if actionSkill.broken}}
              <span class="action-skill-name">{{actionSkill.name}}</span>
            {{else}}
              <a class="action-skill-name" data-action="openSkill" data-uuid="{{actionSkill.uuid}}">{{actionSkill.name}}</a>
            {{/if}}
            {{#if editable}}
              <a class="item-control" data-action="removeSkill" title="{{localize 'LORD_OF_THE_MYSTERIES.Drop.Remove'}}">
                <i class="fas fa-trash"></i>
              </a>
            {{/if}}
          </div>
        {{else}}
          <p class="hint">{{localize rollFields.skillEmptyHint}}</p>
        {{/if}}
        {{#if editable}}<p class="hint">{{localize rollFields.skillHint}}</p>{{/if}}
      </fieldset>

      <!--Attack Roll Macro-->
      <fieldset>
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.AttackRollMacro"}}</legend>
        <input id="attackRollMacro" class="blend-input" type="text" name="system.attackRollMacro" value="{{system.attackRollMacro}}" placeholder="{{localize 'LORD_OF_THE_MYSTERIES.ItemSheet.AttackRollPlaceholder'}}" />
      </fieldset>

      <!--Defense Targeted: which defense of the targeted tokens the attack roll goes against (hit or miss).
          Choices: CONFIG.LORD_OF_THE_MYSTERIES.defenseTargets (helpers/check-results.mjs). Blank = no hit check,
          except a gun shot (Uses ammo: Fire), which is "too fast to dodge" when blank (effectiveDefenseTarget). -->
      <fieldset class="defenseTarget">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.DefenseTargets.Label"}}</legend>
        <select name="system.defenseTarget" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions config.defenseTargets selected=system.defenseTarget blank=(localize rollFields.defenseBlank) localize=true}}
        </select>
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.DefenseTargets.Hint"}}</p>
      </fieldset>

      <!--DC: a fixed DC for the roll (blank = none). The roll window can change it for one roll. -->
      <fieldset class="actionDc">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.Action.DC"}}</legend>
        <input class="blend-input" type="number" name="system.dc" value="{{system.dc}}" min="0" step="1" placeholder="—" />
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Action.DCHint"}}</p>
      </fieldset>

      <!--Outcome tables: Roll Tables drawn after the roll, by its result against the DC. Drop a Roll Table on a slot
          (helpers/table-slot.mjs); the chat card's Roll Outcome button draws it (helpers/outcome-tables.mjs). -->
      <fieldset class="outcome-tables">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.OutcomeTables.Label"}}</legend>
        {{#each outcomeTables as |slot|}}
        <div class="action-skill-entry outcome-table-slot" data-table-slot="{{slot.field}}">
          <span class="outcome-table-label">{{slot.label}}</span>
          {{#if slot.uuid}}
            <img src="{{slot.img}}" alt="" width="24" height="24">
            {{#if slot.broken}}
              <span class="action-skill-name">{{slot.name}}</span>
            {{else}}
              <a class="action-skill-name" data-action="openTable" data-uuid="{{slot.uuid}}">{{slot.name}}</a>
            {{/if}}
            {{#if @root.editable}}
              <a class="item-control" data-action="removeTable" data-field="{{slot.field}}" title="{{localize 'LORD_OF_THE_MYSTERIES.Drop.Remove'}}">
                <i class="fas fa-trash"></i>
              </a>
            {{/if}}
          {{else}}
            <span class="hint">{{localize "LORD_OF_THE_MYSTERIES.OutcomeTables.Empty"}}</span>
          {{/if}}
        </div>
        {{/each}}
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.OutcomeTables.Hint"}}</p>
      </fieldset>

      <!--Damage Roll Macro. Parts can name their own damage type: 2d6[fire] + 1d4[cold]. -->
      <fieldset>
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.DamageRollMacro"}}</legend>
        <input id="damageRollMacro" class="blend-input" type="text" name="system.damageRollMacro" value="{{system.damageRollMacro}}" placeholder="2d8[fire]" />
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Action.DamageTypesHint"}}</p>
      </fieldset>

      <!--Damage Type: the type of every part of the damage formula that doesn't name its own (2d6[fire] does).
          Choices come from CONFIG.LORD_OF_THE_MYSTERIES.damageTypes. The blank first option = no damage type. -->
      <fieldset class="damageType">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.DamageType"}}</legend>
        <select name="system.damageType" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions config.damageTypes selected=system.damageType blank="" localize=true}}
        </select>
      </fieldset>
