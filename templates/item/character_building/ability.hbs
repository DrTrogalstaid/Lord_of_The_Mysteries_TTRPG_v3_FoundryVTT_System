<!--TODO: Change this to a sheet that can be filled out based on Sequence's data model data -->
<div class="{{cssClass}} sequence-sheet-root">

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="sheet">
    <a class="item {{tabs.description.cssClass}}" data-tab="description" data-group="sheet" data-action="tab">Description</a>
    <a class="item {{tabs.details.cssClass}}" data-tab="details" data-group="sheet" data-action="tab">Details</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab description {{tabs.description.cssClass}}" data-group="sheet" data-tab="description">
      <div class="description-box">
        <div class="box-title">Description</div>
        {{#if editable}}
          <prose-mirror name="system.description" button="true" editable="{{editable}}" toggled="false" value="{{system.description}}">
            {{{enrichedDescription}}}
          </prose-mirror>
        {{else}}
          {{{enrichedDescription}}}
        {{/if}}
      </div>
      <div class="description-box">
        <div class="box-title">Special</div>
        {{#if editable}}
          <prose-mirror name="system.special" button="true" editable="{{editable}}" toggled="false" value="{{system.special}}">
            {{{enrichedSpecial}}}
          </prose-mirror>
        {{else}}
          {{{enrichedSpecial}}}
        {{/if}}
      </div>
    </div>
    

    {{!-- Details Tab --}}
    <div class="tab details {{tabs.details.cssClass}}" data-group="sheet" data-tab="details">

      <!--TODO: Put Trigger, Spirituality Cost, and Range in a sidebar-->
      <!--Trigger-->
      <fieldset>
        <legend>Trigger</legend>
          <input id="trigger" class="blend-input" type="text" name="system.trigger" value="{{system.trigger}}" placeholder="Trigger" />
      </fieldset>

      <!--Spirituality Cost-->
      <fieldset>
        <legend>Spirituality Cost</legend>
          <input id="spiritualityCost" class="blend-input" type="number" name="system.spiritualityCost" value="{{system.spiritualityCost}}" />
      </fieldset>
      
      <fieldset class="actionType ">
        <legend>Action Type</legend>
        <select name="system.actionType" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions config.actionTypes selected=system.actionType localize=true blank=""}}
        </select>
      </fieldset>

      <!--Range-->
      <fieldset>
        <legend>Range</legend>
          <input id="range" class="blend-input" type="number" name="system.range" value="{{system.range}}" />
      </fieldset>

      <!--Sequence Upgrades-->
      <fieldset class="sequence-upgrades">
        <legend>Sequence Upgrades</legend>
        <ol class="items-list">
          {{#each higherSequenceUpgrades as |row|}}
          <li class="item flexrow">
            <input type="text" class="blend-input flexlarge"
                  name="system.higherSequenceUpgrades.{{row.index}}"
                  value="{{row.value}}" placeholder="Upgrade description" />
            <div class="item-controls">
              <a class="item-control" data-action="deleteSequenceUpgrade" data-index="{{row.index}}" title="Delete">
                <i class="fas fa-trash"></i>
              </a>
            </div>
          </li>
          {{/each}}
        </ol>
        <a class="item-control add-row" data-action="addSequenceUpgrade">
          <i class="fas fa-plus"></i> Add Upgrade
        </a>
      </fieldset>

      <!--Spell List-->
      <fieldset class="spell-list" data-drop-zone="spellList">
        <legend>
          <input type="text" class="blend-input" name="system.spellList.name"
                value="{{system.spellList.name}}" placeholder="Spells" />
        </legend>
        <ol class="items-list">
          <li class="items-header flexrow">
            <div class="item-name">Spell</div>
            <div class="item-controls"></div>
          </li>
          {{#each spellListSpells as |row|}}
          <li class="item flexrow" data-uuid="{{row.uuid}}">
            <div class="item-name">
              <img class="item-image" src="{{row.img}}" alt="{{row.name}}"/>
              <h4>{{row.name}}</h4>
            </div>
            <div class="item-controls">
              <a class="item-control" data-action="deleteSpell" data-index="{{row.index}}" title="Delete">
                <i class="fas fa-trash"></i>
              </a>
            </div>
          </li>
          {{/each}}
          {{#unless spellListSpells.length}}
          <li class="item flexrow drop-hint">Drag a Spell</li>
          {{/unless}}
        </ol>
      </fieldset>

      <!--Action List-->
      <fieldset class="actions-gained" data-drop-zone="actionList">
        <legend>Actions</legend>
        <ol class="items-list">
          <li class="items-header flexrow">
            <div class="item-name">Ability</div>
            <div class="item-controls"></div>
          </li>
          {{#each actionListActions as |row|}}
          <li class="item flexrow" data-uuid="{{row.uuid}}">
            <div class="item-name">
              <img class="item-image" src="{{row.img}}" alt="{{row.name}}"/>
              <h4>{{row.name}}</h4>
            </div>
            <div class="item-controls">
              <a class="item-control" data-action="deleteAction" data-index="{{row.index}}" title="Delete">
                <i class="fas fa-trash"></i>
              </a>
            </div>
          </li>
          {{/each}}
          {{#unless actionListActions.length}}
          <li class="item flexrow drop-hint">Drag an Action</li>
          {{/unless}}
        </ol>
      </fieldset>

      <!--Granted Skills-->
      <fieldset class="granted-skills">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.GrantedSkills.GrantsSkills"}}</legend>
        <label class="flexrow">
          <input type="checkbox" name="system.grantsSkills" {{checked system.grantsSkills}} {{#unless editable}}disabled{{/unless}} />
          {{localize "LORD_OF_THE_MYSTERIES.GrantedSkills.GrantsSkillsHint"}}
        </label>
        <label class="flexrow">
          <input type="checkbox" name="system.analyzeSkills" {{checked system.analyzeSkills}} {{#unless editable}}disabled{{/unless}} />
          {{localize "LORD_OF_THE_MYSTERIES.GrantedSkills.AnalyzeSkillsHint"}}
        </label>
      </fieldset>

      <!--Skill Options-->
      <fieldset class="skill-options" data-drop-zone="skillOptions">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.GrantedSkills.Options"}}</legend>
        <ol class="items-list">
          <li class="items-header flexrow">
            <div class="item-name">Skill</div>
            <div class="item-controls"></div>
          </li>
          {{#each skillOptionRows as |row|}}
          <li class="item flexrow" data-uuid="{{row.uuid}}">
            <div class="item-name">
              <img class="item-image" src="{{row.img}}" alt="{{row.name}}"/>
              <h4>{{row.name}}</h4>
            </div>
            <div class="item-controls">
              <a class="item-control" data-action="deleteSkillOption" data-index="{{row.index}}" title="Delete">
                <i class="fas fa-trash"></i>
              </a>
            </div>
          </li>
          {{/each}}
          {{#unless skillOptionRows.length}}
          <li class="item flexrow drop-hint">{{localize "LORD_OF_THE_MYSTERIES.GrantedSkills.DropHint"}}</li>
          {{/unless}}
        </ol>
      </fieldset>

      <!--Learning by Doing (helpers/skill-learning.mjs)-->
      <fieldset class="fast-learning skill-categories">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.Learning.Fast.Title"}}</legend>
        <label class="flexrow">
          <input type="checkbox" name="system.fastLearning.enabled" {{checked system.fastLearning.enabled}} {{#unless editable}}disabled{{/unless}} />
          {{localize "LORD_OF_THE_MYSTERIES.Learning.Fast.EnabledHint"}}
        </label>

        {{#if system.fastLearning.enabled}}
        <label>{{localize "LORD_OF_THE_MYSTERIES.Learning.Fast.Condition"}}</label>
        <input type="text" class="blend-input" name="system.fastLearning.condition" value="{{system.fastLearning.condition}}"
               placeholder="{{localize 'LORD_OF_THE_MYSTERIES.Learning.Fast.ConditionPlaceholder'}}" {{#unless editable}}disabled{{/unless}} />

        <label>{{localize "LORD_OF_THE_MYSTERIES.Learning.Fast.MaxLevel"}}</label>
        <select name="system.fastLearning.maxLevel" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions config.skillLevels selected=system.fastLearning.maxLevel localize=true}}
        </select>

        <label>{{localize "LORD_OF_THE_MYSTERIES.Learning.Fast.Categories"}}</label>
        {{#each system.fastLearning.categories as |category|}}
        <div class="skill-category-row">
          <select name="system.fastLearning.categories.{{@index}}" {{#unless @root.editable}}disabled{{/unless}}>
            {{selectOptions @root.config.skillCategories selected=category localize=true}}
          </select>
          {{#if @root.editable}}
          <a class="skill-category-remove" data-action="removeFastCategory" data-index="{{@index}}"
             data-tooltip="{{localize 'LORD_OF_THE_MYSTERIES.Learning.Fast.RemoveCategory'}}"><i class="fa-solid fa-trash"></i></a>
          {{/if}}
        </div>
        {{/each}}
        {{#if editable}}
        <a class="item-control add-row" data-action="addFastCategory">
          <i class="fas fa-plus"></i> {{localize "LORD_OF_THE_MYSTERIES.Learning.Fast.AddCategory"}}
        </a>
        {{/if}}

        <label>{{localize "LORD_OF_THE_MYSTERIES.Learning.Fast.Skills"}}</label>
        <ol class="items-list" data-drop-zone="fastLearningSkills">
          {{#each fastSkillRows as |row|}}
          <li class="item flexrow" data-uuid="{{row.uuid}}">
            <div class="item-name">
              <img class="item-image" src="{{row.img}}" alt="{{row.name}}"/>
              <h4>{{row.name}}</h4>
            </div>
            <div class="item-controls">
              <a class="item-control" data-action="deleteFastSkill" data-index="{{row.index}}" title="Delete">
                <i class="fas fa-trash"></i>
              </a>
            </div>
          </li>
          {{/each}}
          {{#unless fastSkillRows.length}}
          <li class="item flexrow drop-hint">{{localize "LORD_OF_THE_MYSTERIES.GrantedSkills.DropHint"}}</li>
          {{/unless}}
        </ol>
        {{/if}}
      </fieldset>

      <!--Can Be Stolen-->
      <fieldset>
        <legend>Can Be Stolen/Recorded</legend>
          <input id="canBeStolen" class="blend-input" type="bool" name="system.canBeStolen" value="{{system.canBeStolen}}" placeholder="Can Be Stolen" />
      </fieldset>
    </div>

  </section>

</div>
