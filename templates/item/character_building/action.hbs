<div class="{{cssClass}} sequence-sheet-root">

  {{> "systems/lotm/templates/item/parts/tab-nav.hbs" effects=true}}

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab description {{tabs.description.cssClass}}" data-group="sheet" data-tab="description">
      <div class="description-box">
        <div class="box-title">{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.Description"}}</div>
        {{> "systems/lotm/templates/parts/rich-text.hbs" name="system.description" value=system.description enriched=enrichedDescription}}
      </div>
      <div class="description-box">
      <!--Special Results (Great Success / Big Failure events)-->
      {{> "systems/lotm/templates/item/parts/text-rows.hbs" field="system.specialResults" rows=specialResults
          class="special-results" legend="LORD_OF_THE_MYSTERIES.ItemSheet.SpecialResults"
          placeholder="LORD_OF_THE_MYSTERIES.ItemSheet.SpecialResultPlaceholder" addLabel="LORD_OF_THE_MYSTERIES.ItemSheet.AddSpecialResult"}}
      </div>
    </div>

    {{!-- Details Tab --}}
    <div class="tab details {{tabs.details.cssClass}}" data-group="sheet" data-tab="details">

      <!--Title-->
      <fieldset>
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.Title"}}</legend>
        <input id="title" class="blend-input" type="text" name="system.title" value="{{system.title}}" placeholder="{{localize 'LORD_OF_THE_MYSTERIES.ItemSheet.TitlePlaceholder'}}" />
      </fieldset>

      <!--Action Type-->
      <fieldset class="actionType">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.ActionType"}}</legend>
        <select name="system.actionType" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions config.actionTypes selected=system.actionType localize=true}}
        </select>
      </fieldset>

      <!--Traits: speech, reaction, grapple, parry, aimed (templates/item/parts/action-traits.hbs)-->
      {{> "systems/lotm/templates/item/parts/action-traits.hbs"}}

      <!--Category-->
      <fieldset class="category">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.Category"}}</legend>
        <select name="system.category" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions config.actionCategories selected=system.category localize=true}}
        </select>
      </fieldset>

      <!--Spirituality Cost-->
      <fieldset>
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.SpiritualityCost"}}</legend>
        <input id="spiritualityCost" class="blend-input" type="number" name="system.spiritualityCost" value="{{system.spiritualityCost}}" min="0" step="1" />
      </fieldset>

      <!--Range-->
      <fieldset>
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.Range"}}</legend>
        <input id="range" class="blend-input" type="number" name="system.range" value="{{system.range}}" min="0" step="1" />
      </fieldset>

      {{!-- Modifiers, Skill, Attack Roll Macro, Defense Targeted, DC, outcome tables, damage (shared with spells) --}}
      {{> "systems/lotm/templates/item/parts/roll-fields.hbs"}}

      <!--Uses Ammo: whether this action fires its gun (helpers/firearms.mjs). Options from action-sheet.mjs (ammoUseOptions). -->
      <fieldset class="ammoUse">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.Firearm.AmmoUse.Label"}}</legend>
        <select name="system.ammoUse" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions ammoUseOptions selected=system.ammoUse localize=true}}
        </select>
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Firearm.AmmoUse.Hint"}}</p>
        {{#if isOldAmmoUse}}
          <p class="hint"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "LORD_OF_THE_MYSTERIES.Firearm.AmmoUse.OldHint"}}</p>
        {{/if}}
      </fieldset>

      <!--Rounds per shot: only for actions that fire. -->
      {{#if (eq system.ammoUse "fire")}}
        <fieldset>
          <legend>{{localize "LORD_OF_THE_MYSTERIES.Firearm.AmmoAmount"}}</legend>
          <input id="ammoAmount" class="blend-input" type="number" name="system.ammoAmount" value="{{system.ammoAmount}}" min="0" step="1" />
          <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Firearm.AmmoAmountHint"}}</p>
        </fieldset>
      {{/if}}

      <!--DC Results-->
      <fieldset class="dc-results">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.DCResults"}}</legend>
        <textarea id="dcResults" class="blend-input" name="system.dcResults" rows="4" placeholder="{{localize 'LORD_OF_THE_MYSTERIES.ItemSheet.ResultsPlaceholder'}}" {{#unless editable}}disabled{{/unless}}>{{system.dcResults}}</textarea>
      </fieldset>

    </div>

    {{!-- Effects Tab: the item's effects (templates/item/parts/item-effects.hbs) --}}
    <div class="tab effects {{tabs.effects.cssClass}}" data-group="sheet" data-tab="effects">
      {{> "systems/lotm/templates/item/parts/item-effects.hbs"}}
    </div>

  </section>

</div>
