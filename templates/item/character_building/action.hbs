<div class="{{cssClass}} sequence-sheet-root">

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="sheet">
    <a class="item {{tabs.description.cssClass}}" data-tab="description" data-group="sheet" data-action="tab">Description</a>
    <a class="item {{tabs.details.cssClass}}" data-tab="details" data-group="sheet" data-action="tab">Details</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab description {{tabs.description.cssClass}}" data-group="sheet" data-tab="description">
      <div class="description-box">
        <div class="box-title">Description</div>
        {{#if editable}}
          <prose-mirror name="system.description" button="true" editable="{{editable}}" toggled="false" value="{{system.description}}">
            {{{enrichedDescription}}}
          </prose-mirror>
        {{else}}
          {{{enrichedDescription}}}
        {{/if}}
      </div>
      <div class="description-box">
      <!--Special Results (Great Success / Big Failure events)-->
      <fieldset class="special-results">
        <legend>Special Results</legend>
        <ol class="items-list">
          {{#each specialResults as |row|}}
          <li class="item flexrow">
            <input type="text" class="blend-input flexlarge"
                  name="system.specialResults.{{row.index}}"
                  value="{{row.value}}" placeholder="Great success / big failure event" />
            <div class="item-controls">
              <a class="item-control" data-action="deleteSpecialResult" data-index="{{row.index}}" title="Delete">
                <i class="fas fa-trash"></i>
              </a>
            </div>
          </li>
          {{/each}}
        </ol>
        <a class="item-control add-row" data-action="addSpecialResult">
          <i class="fas fa-plus"></i> Add Special Result
        </a>
      </fieldset>
      </div>
    </div>

    {{!-- Details Tab --}}
    <div class="tab details {{tabs.details.cssClass}}" data-group="sheet" data-tab="details">

      <!--Title-->
      <fieldset>
        <legend>Title</legend>
        <input id="title" class="blend-input" type="text" name="system.title" value="{{system.title}}" placeholder="Action Title" />
      </fieldset>

      <!--Action Type-->
      <fieldset class="actionType">
        <legend>Action Type</legend>
        <select name="system.actionType" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions config.actionTypes selected=system.actionType localize=true}}
        </select>
      </fieldset>

      <!--Category-->
      <fieldset class="category">
        <legend>Category</legend>
        <select name="system.category" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions config.actionCategories selected=system.category localize=true}}
        </select>
      </fieldset>

      <!--Spirituality Cost-->
      <fieldset>
        <legend>Spirituality Cost</legend>
        <input id="spiritualityCost" class="blend-input" type="number" name="system.spiritualityCost" value="{{system.spiritualityCost}}" min="0" step="1" />
      </fieldset>

      <!--Range-->
      <fieldset>
        <legend>Range</legend>
        <input id="range" class="blend-input" type="number" name="system.range" value="{{system.range}}" min="0" step="1" />
      </fieldset>

      <!--Modifiers-->
      <fieldset>
        <legend>Modifiers</legend>
        <input id="modifiers" class="blend-input" type="number" name="system.modifiers" value="{{system.modifiers}}" step="1" />
      </fieldset>

      <!--Skill: the skill this action rolls with (e.g. Pistol). Drop a skill here; dropping another replaces it.
          Drop handling: bindSkillSlot() in helpers/skill-slot.mjs. -->
      <fieldset class="action-skill" data-skill-slot>
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ActionSkill.Label"}}</legend>
        {{#if actionSkill}}
          <div class="action-skill-entry">
            <img src="{{actionSkill.img}}" alt="" width="24" height="24">
            {{#if actionSkill.broken}}
              <span class="action-skill-name">{{actionSkill.name}}</span>
            {{else}}
              <a class="action-skill-name" data-action="openSkill" data-uuid="{{actionSkill.uuid}}">{{actionSkill.name}}</a>
            {{/if}}
            {{#if editable}}
              <a class="item-control" data-action="removeSkill" title="{{localize 'LORD_OF_THE_MYSTERIES.Drop.Remove'}}">
                <i class="fas fa-trash"></i>
              </a>
            {{/if}}
          </div>
        {{else}}
          <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.ActionSkill.None"}}</p>
        {{/if}}
        {{#if editable}}<p class="hint">{{localize "LORD_OF_THE_MYSTERIES.ActionSkill.Hint"}}</p>{{/if}}
      </fieldset>

      <!--Attack Roll Macro-->
      <fieldset>
        <legend>Attack Roll Macro</legend>
        <input id="attackRollMacro" class="blend-input" type="text" name="system.attackRollMacro" value="{{system.attackRollMacro}}" placeholder="1d20 (the skill bonus is added when rolled)" />
      </fieldset>

      <!--Damage Roll Macro-->
      <fieldset>
        <legend>Damage Roll Macro</legend>
        <input id="damageRollMacro" class="blend-input" type="text" name="system.damageRollMacro" value="{{system.damageRollMacro}}" placeholder="Damage roll macro" />
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Action.DamageTypesHint"}}</p>
      </fieldset>

      <!--Damage Type: the type of every part of the damage formula that doesn't name its own (2d6[fire] does).
          Choices come from CONFIG.LORD_OF_THE_MYSTERIES.damageTypes. The blank first option = no damage type. -->
      <fieldset class="damageType">
        <legend>Damage Type</legend>
        <select name="system.damageType" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions config.damageTypes selected=system.damageType blank="" localize=true}}
        </select>
      </fieldset>

      <!--Uses Ammo: what this action does to its gun (helpers/firearms.mjs). Options from action-sheet.mjs (ammoUseOptions). -->
      <fieldset class="ammoUse">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.Firearm.AmmoUse.Label"}}</legend>
        <select name="system.ammoUse" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions ammoUseOptions selected=system.ammoUse localize=true}}
        </select>
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Firearm.AmmoUse.Hint"}}</p>
      </fieldset>

      <!--Rounds per use: only for actions that fire or reload. -->
      {{#if (or (eq system.ammoUse "fire") (eq system.ammoUse "reload"))}}
        <fieldset>
          <legend>{{localize "LORD_OF_THE_MYSTERIES.Firearm.AmmoAmount"}}</legend>
          <input id="ammoAmount" class="blend-input" type="number" name="system.ammoAmount" value="{{system.ammoAmount}}" min="0" step="1" />
          <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Firearm.AmmoAmountHint"}}</p>
        </fieldset>
      {{/if}}

      <!--DC Results-->
      <fieldset class="dc-results">
        <legend>DC Results</legend>
        <textarea id="dcResults" class="blend-input" name="system.dcResults" rows="4" placeholder="Results" {{#unless editable}}disabled{{/unless}}>{{system.dcResults}}</textarea>
      </fieldset>

    </div>

  </section>

</div>
