<!--TODO: Change this to a sheet that can be filled out based on Sequence's data model data -->
<div class="{{cssClass}}">

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="sheet">
    <a class="item {{tabs.description.cssClass}}" data-tab="description" data-group="sheet" data-action="tab">Description</a>
    <a class="item {{tabs.details.cssClass}}" data-tab="details" data-group="sheet" data-action="tab">Details</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab description {{tabs.description.cssClass}}" data-group="sheet" data-tab="description">
      {{!-- Editors must receive enriched text data from getData to properly handle rolls --}}
      {{#if editable}}
        <prose-mirror name="system.description" button="true" editable="{{editable}}" toggled="false" value="{{system.description}}">
          {{{enrichedDescription}}}
        </prose-mirror>
      {{else}}
        {{{enrichedDescription}}}
      {{/if}}

    </div>

    {{!-- Details Tab --}}
    <div class="tab details {{tabs.details.cssClass}}" data-group="sheet" data-tab="details">
      <!--Sequence Number (sequence number - overrides lower sequences on actor sheets)-->
      <div class="sequenceNumber flexrow">
        <label>Sequence Number</label>
        <input type="number" name="system.sequence_number" value="{{system.sequence_number}}" data-dtype="Number"/>
      </div>
      <!--Acting Principals (string GM secret)-->
      <div class="actingPrincipals flexrow">
        <label>Acting Principals</label>
        <input type="text" name="system.acting_principals" value="{{system.acting_principals}}" data-dtype="Text"/>
      </div>
      <!--Attribute Gain (list of attribute increases)-->
      <div class="attributeGain flexrow">
        <label>Attribute Gain</label>
        <input type="text" name="system.attribute_gain" value="{{system.attribute_gain}}" data-dtype="Array"/>
      </div>
      <!--Skill Increase (list of skill items/increases to add to actor)-->
      <div class="skillIncrease flexrow">
        <label>Attribute Gain</label>
        <input type="text" name="system.skill_increase" value="{{system.skill_increase}}" data-dtype="Array"/>
      </div>
      <!--Abilities Gain (list of ability items that are added to actor)-->
      <div class="skillIncrease flexrow">
        <label>Abilities Gained</label>
        <input type="text" name="system.abilities_gained" value="{{system.abilities_gained}}" data-dtype="Array"/>
      </div>

    </div>

  </section>

</div>