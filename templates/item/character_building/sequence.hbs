<div class="{{cssClass}} sequence-sheet-root">

  {{> "systems/lotm/templates/item/parts/tab-nav.hbs" effects=true}}

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab description {{tabs.description.cssClass}}" data-group="sheet" data-tab="description">
      {{> "systems/lotm/templates/parts/rich-text.hbs" name="system.description" value=system.description enriched=enrichedDescription}}

    </div>

    {{!-- Details Tab --}}
    <div class="tab details {{tabs.details.cssClass}}" data-group="sheet" data-tab="details">

      <!--Sequence Number (sequence number - overrides lower sequences on actor sheets)-->
      <div class="sequenceNumber flexrow">
        <label>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.SequenceNumber"}}</label>
        <input type="number" name="system.sequence_number" value="{{system.sequence_number}}" data-dtype="Number"/>
      </div>

      <!--Digestion Amount-->
      <div class="digestionAmount flexrow">
        <label>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.DigestionAmount"}}</label>
        <input type="number" name="system.digestionAmount" value="{{system.digestionAmount}}" data-dtype="Number"/>
      </div>

      <!--Acting Principals (string GM secret)-->
      <fieldset class="actingPrincipals flexrow">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.ActingPrinciples"}}</legend>
        {{> "systems/lotm/templates/parts/rich-text.hbs" name="system.acting_principals" value=system.acting_principals enriched=enrichedActingPrincipals}}
      </fieldset>

      <!--Attribute Gain (list of attribute increases)-->
      <fieldset class="attribute-gain">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.AttributeGain"}}</legend>
        <ol class="items-list">
          <li class="items-header flexrow">
            <div class="item-name">{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.Attribute"}}</div>
            <div class="item-prop">{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.Value"}}</div>
            <div class="item-controls"></div>
          </li>
          {{#each attributeGain as |row|}}
          <li class="item flexrow">
            <div class="item-name">
              <select name="system.attribute_gain.{{row.index}}.attribute_name">
                {{selectOptions ../attributeChoices selected=row.attribute_name localize=true}}
              </select>
            </div>
            <div class="item-prop">
              <input type="number" name="system.attribute_gain.{{row.index}}.value" value="{{row.value}}" data-dtype="Number"/>
            </div>
            <div class="item-controls">
              <a class="item-control" data-action="deleteAttributeGain" data-index="{{row.index}}" title="{{localize 'LORD_OF_THE_MYSTERIES.ItemSheet.Delete'}}">
                <i class="fas fa-trash"></i>
              </a>
            </div>
          </li>
          {{/each}}
        </ol>
        <a class="item-control add-row" data-action="addAttributeGain">
          <i class="fas fa-plus"></i> {{localize "LORD_OF_THE_MYSTERIES.ItemSheet.AddAttribute"}}
        </a>
      </fieldset>

      <!--Skill Increase -->
      <fieldset class="skill-increase" data-drop-zone="skill_increase">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.SkillIncrease"}}</legend>
        <ol class="items-list">
          <li class="items-header flexrow">
            <div class="item-name">{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.Skill"}}</div>
            <div class="item-prop">{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.Value"}}</div>
            <div class="item-controls"></div>
          </li>
          {{#each skillIncrease as |row|}}
          <li class="item flexrow" data-uuid="{{row.uuid}}">
            <div class="item-name">
              <img class="item-image" src="{{row.img}}" alt="{{row.name}}"/>
              <h4>{{row.name}}</h4>
            </div>
            <div class="item-prop">
              <input type="number" name="system.skill_increase.{{row.index}}.value" value="{{row.value}}" data-dtype="Number"/>
              <input type="hidden" name="system.skill_increase.{{row.index}}.skill_uuid" value="{{row.uuid}}"/>
            </div>
            <div class="item-controls">
              <a class="item-control" data-action="deleteSkillIncrease" data-index="{{row.index}}" title="{{localize 'LORD_OF_THE_MYSTERIES.ItemSheet.Delete'}}">
                <i class="fas fa-trash"></i>
              </a>
            </div>
          </li>
          {{/each}}
          {{#unless skillIncrease.length}}
          <li class="item flexrow drop-hint">{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.DragSkill"}}</li>
          {{/unless}}
        </ol>
      </fieldset>

      <!--Knowledge and Training: skills this Sequence makes one study schedule faster (helpers/skill-learning.mjs)-->
      <fieldset class="training-bonus" data-drop-zone="trainingBonus">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.Learning.TrainingBonus.Title"}}</legend>
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Learning.TrainingBonus.Hint"}}</p>
        <ol class="items-list">
          <li class="items-header flexrow">
            <div class="item-name">{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.Skill"}}</div>
            <div class="item-controls"></div>
          </li>
          {{#each trainingBonus as |row|}}
          <li class="item flexrow" data-uuid="{{row.uuid}}">
            <div class="item-name">
              <img class="item-image" src="{{row.img}}" alt="{{row.name}}"/>
              <h4>{{row.name}}</h4>
            </div>
            <div class="item-controls">
              {{#if @root.editable}}
              <a class="item-control" data-action="deleteTrainingBonus" data-index="{{row.index}}" title="{{localize 'LORD_OF_THE_MYSTERIES.ItemSheet.Delete'}}">
                <i class="fas fa-trash"></i>
              </a>
              {{/if}}
            </div>
          </li>
          {{/each}}
          {{#unless trainingBonus.length}}
          <li class="item flexrow drop-hint">{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.DragSkill"}}</li>
          {{/unless}}
        </ol>
      </fieldset>

      <!--Abilities Gained -->
      <fieldset class="abilities-gained" data-drop-zone="abilities_gained">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.AbilitiesGained"}}</legend>
        <ol class="items-list">
          <li class="items-header flexrow">
            <div class="item-name">{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.Ability"}}</div>
            <div class="item-controls"></div>
          </li>
          {{#each abilitiesGained as |row|}}
          <li class="item flexrow" data-uuid="{{row.uuid}}">
            <div class="item-name">
              <img class="item-image" src="{{row.img}}" alt="{{row.name}}"/>
              <h4>{{row.name}}</h4>
            </div>
            <div class="item-controls">
              <a class="item-control" data-action="deleteAbilityGained" data-index="{{row.index}}" title="{{localize 'LORD_OF_THE_MYSTERIES.ItemSheet.Delete'}}">
                <i class="fas fa-trash"></i>
              </a>
            </div>
          </li>
          {{/each}}
          {{#unless abilitiesGained.length}}
          <li class="item flexrow drop-hint">{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.DragAbility"}}</li>
          {{/unless}}
        </ol>
      </fieldset>

    </div>

    {{!-- Effects Tab: the item's effects (templates/item/parts/item-effects.hbs) --}}
    <div class="tab effects {{tabs.effects.cssClass}}" data-group="sheet" data-tab="effects">
      {{> "systems/lotm/templates/item/parts/item-effects.hbs"}}
    </div>

  </section>

</div>
