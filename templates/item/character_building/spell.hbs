<div class="{{cssClass}} sequence-sheet-root">

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="sheet">
    <a class="item {{tabs.description.cssClass}}" data-tab="description" data-group="sheet" data-action="tab">Description</a>
    <a class="item {{tabs.details.cssClass}}" data-tab="details" data-group="sheet" data-action="tab">Details</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab description {{tabs.description.cssClass}}" data-group="sheet" data-tab="description">
      <div class="description-box">
        <div class="box-title">Description</div>
        {{#if editable}}
          <prose-mirror name="system.description" button="true" editable="{{editable}}" toggled="false" value="{{system.description}}">
            {{{enrichedDescription}}}
          </prose-mirror>
        {{else}}
          {{{enrichedDescription}}}
        {{/if}}
      </div>
      <div class="description-box">
        <div class="box-title">Special</div>
        {{#if editable}}
          <prose-mirror name="system.special" button="true" editable="{{editable}}" toggled="false" value="{{system.special}}">
            {{{enrichedSpecial}}}
          </prose-mirror>
        {{else}}
          {{{enrichedSpecial}}}
        {{/if}}
      </div>
    </div>

    {{!-- Details Tab --}}
    <div class="tab details {{tabs.details.cssClass}}" data-group="sheet" data-tab="details">

      <fieldset class="actionType ">
        <legend>Action Type</legend>
        <select name="system.actionType" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions config.actionTypes selected=system.actionType localize=true blank=""}}
        </select>
      </fieldset>

      <!--TODO: Put Target, Spirituality Cost, and Range in a sidebar-->
      <!--Target-->
      <fieldset>
        <legend>Target</legend>
        <input id="target" class="blend-input" type="text" name="system.target" value="{{system.target}}" placeholder="Target" />
      </fieldset>

      <!--Spirituality Cost-->
      <fieldset>
        <legend>Spirituality Cost</legend>
        <input id="spiritualityCost" class="blend-input" type="number" name="system.spiritualityCost" value="{{system.spiritualityCost}}" />
      </fieldset>
      
      <!--Range-->
      <fieldset>
        <legend>Range</legend>
        <input id="range" class="blend-input" type="number" name="system.range" value="{{system.range}}" />
      </fieldset>

      {{!-- Rolls: the same fields as an action (spell.mjs), so a spell rolls like one from the sheets. --}}

      <!--Skill: the skill this spell rolls with. Empty = Occultism. Drop handling: bindSkillSlot() in helpers/skill-slot.mjs. -->
      <fieldset class="action-skill" data-skill-slot>
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ActionSkill.Label"}}</legend>
        {{#if actionSkill}}
          <div class="action-skill-entry">
            <img src="{{actionSkill.img}}" alt="" width="24" height="24">
            {{#if actionSkill.broken}}
              <span class="action-skill-name">{{actionSkill.name}}</span>
            {{else}}
              <a class="action-skill-name" data-action="openSkill" data-uuid="{{actionSkill.uuid}}">{{actionSkill.name}}</a>
            {{/if}}
            {{#if editable}}
              <a class="item-control" data-action="removeSkill" title="{{localize 'LORD_OF_THE_MYSTERIES.Drop.Remove'}}">
                <i class="fas fa-trash"></i>
              </a>
            {{/if}}
          </div>
        {{else}}
          <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.ActionSkill.SpellDefault"}}</p>
        {{/if}}
        {{#if editable}}<p class="hint">{{localize "LORD_OF_THE_MYSTERIES.ActionSkill.SpellHint"}}</p>{{/if}}
      </fieldset>

      <!--Attack Roll Macro-->
      <fieldset>
        <legend>Attack Roll Macro</legend>
        <input id="attackRollMacro" class="blend-input" type="text" name="system.attackRollMacro" value="{{system.attackRollMacro}}" placeholder="1d20 (the skill bonus is added when rolled)" />
      </fieldset>

      <!--Modifiers-->
      <fieldset>
        <legend>Modifiers</legend>
        <input id="modifiers" class="blend-input" type="number" name="system.modifiers" value="{{system.modifiers}}" step="1" />
      </fieldset>

      <!--Damage Roll Macro. Parts can name their own damage type: 2d6[fire] + 1d4[cold]. -->
      <fieldset>
        <legend>Damage Roll Macro</legend>
        <input id="damageRollMacro" class="blend-input" type="text" name="system.damageRollMacro" value="{{system.damageRollMacro}}" placeholder="2d8[fire]" />
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Action.DamageTypesHint"}}</p>
      </fieldset>

      <!--Damage Type: for the parts of the damage formula that don't name their own. -->
      <fieldset class="damageType">
        <legend>Damage Type</legend>
        <select name="system.damageType" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions config.damageTypes selected=system.damageType blank="" localize=true}}
        </select>
      </fieldset>

      <!--DC Results-->
      <fieldset>
        <legend>DC Results</legend>
        <input id="dcResults" class="blend-input" type="text" name="system.dcResults" value="{{system.dcResults}}" placeholder="DC Results" />
      </fieldset>

      <!--Sequence Upgrades-->
      <fieldset class="sequence-upgrades">
        <legend>Sequence Upgrades</legend>
        <ol class="items-list">
          {{#each higherSequenceUpgrades as |row|}}
          <li class="item flexrow">
            <input type="text" class="blend-input flexlarge"
                  name="system.higherSequenceUpgrades.{{row.index}}"
                  value="{{row.value}}" placeholder="Upgrade description" />
            <div class="item-controls">
              <a class="item-control" data-action="deleteSequenceUpgrade" data-index="{{row.index}}" title="Delete">
                <i class="fas fa-trash"></i>
              </a>
            </div>
          </li>
          {{/each}}
        </ol>
        <a class="item-control add-row" data-action="addSequenceUpgrade">
          <i class="fas fa-plus"></i> Add Upgrade
        </a>
      </fieldset>

      <!--Spell Macto-->
      <fieldset>
        <legend>Spell Macro</legend>
        <input id="spellMacro" class="blend-input" type="text" name="system.spellMacro" value="{{system.spellMacro}}" placeholder="SpellMacro" />
      </fieldset>

      <!--Active Effect-->
      <fieldset>
        <legend>Active Effect Macro</legend>
        <input id="activeEffectMacro" class="blend-input" type="text" name="system.activeEffectMacro" value="{{system.activeEffectMacro}}" placeholder="ActiveEffectMacro" />
      </fieldset>

    </div>

  </section>

</div>
