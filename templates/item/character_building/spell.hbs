<div class="{{cssClass}} sequence-sheet-root">

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="sheet">
    <a class="item {{tabs.description.cssClass}}" data-tab="description" data-group="sheet" data-action="tab">Description</a>
    <a class="item {{tabs.details.cssClass}}" data-tab="details" data-group="sheet" data-action="tab">Details</a>
    <a class="item {{tabs.effects.cssClass}}" data-tab="effects" data-group="sheet" data-action="tab">{{localize "LORD_OF_THE_MYSTERIES.Tabs.Effects"}}</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab description {{tabs.description.cssClass}}" data-group="sheet" data-tab="description">
      <div class="description-box">
        <div class="box-title">Description</div>
        {{#if editable}}
          <prose-mirror name="system.description" button="true" editable="{{editable}}" toggled="false" value="{{system.description}}">
            {{{enrichedDescription}}}
          </prose-mirror>
        {{else}}
          {{{enrichedDescription}}}
        {{/if}}
      </div>
      <div class="description-box">
        <div class="box-title">Special</div>
        {{#if editable}}
          <prose-mirror name="system.special" button="true" editable="{{editable}}" toggled="false" value="{{system.special}}">
            {{{enrichedSpecial}}}
          </prose-mirror>
        {{else}}
          {{{enrichedSpecial}}}
        {{/if}}
      </div>
    </div>

    {{!-- Details Tab --}}
    <div class="tab details {{tabs.details.cssClass}}" data-group="sheet" data-tab="details">

      <fieldset class="actionType ">
        <legend>Action Type</legend>
        <select name="system.actionType" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions config.actionTypes selected=system.actionType localize=true blank=""}}
        </select>
      </fieldset>

      <!--Traits: speech, reaction, grapple, parry, aimed (templates/item/parts/action-traits.hbs)-->
      {{> "systems/lotm/templates/item/parts/action-traits.hbs"}}

      <!--TODO: Put Target, Spirituality Cost, and Range in a sidebar-->
      <!--Target-->
      <fieldset>
        <legend>Target</legend>
        <input id="target" class="blend-input" type="text" name="system.target" value="{{system.target}}" placeholder="Target" />
      </fieldset>

      <!--Spirituality Cost-->
      <fieldset>
        <legend>Spirituality Cost</legend>
        <input id="spiritualityCost" class="blend-input" type="number" name="system.spiritualityCost" value="{{system.spiritualityCost}}" />
      </fieldset>
      
      <!--Range-->
      <fieldset>
        <legend>Range</legend>
        <input id="range" class="blend-input" type="number" name="system.range" value="{{system.range}}" />
      </fieldset>

      {{!-- Rolls: the same fields as an action (spell.mjs), so a spell rolls like one from the sheets.
            Modifiers, Skill, Attack Roll Macro, Defense Targeted, DC, outcome tables, damage. --}}
      {{> "systems/lotm/templates/item/parts/roll-fields.hbs"}}

      <!--DC Results-->
      <fieldset>
        <legend>DC Results</legend>
        <input id="dcResults" class="blend-input" type="text" name="system.dcResults" value="{{system.dcResults}}" placeholder="DC Results" />
      </fieldset>

      <!--Sequence Upgrades-->
      {{> "systems/lotm/templates/item/parts/text-rows.hbs" field="system.higherSequenceUpgrades" rows=higherSequenceUpgrades
          class="sequence-upgrades" legend="Sequence Upgrades" placeholder="Upgrade description" addLabel="Add Upgrade"}}

    </div>

    {{!-- Effects Tab: the item's effects (templates/item/parts/item-effects.hbs) --}}
    <div class="tab effects {{tabs.effects.cssClass}}" data-group="sheet" data-tab="effects">
      {{> "systems/lotm/templates/item/parts/item-effects.hbs"}}
    </div>

  </section>

</div>
