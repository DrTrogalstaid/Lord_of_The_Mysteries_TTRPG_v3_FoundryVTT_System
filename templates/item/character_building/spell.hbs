<div class="{{cssClass}} sequence-sheet-root">

  {{> "systems/lotm/templates/item/parts/tab-nav.hbs" effects=true}}

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab description {{tabs.description.cssClass}}" data-group="sheet" data-tab="description">
      <div class="description-box">
        <div class="box-title">{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.Description"}}</div>
        {{> "systems/lotm/templates/parts/rich-text.hbs" name="system.description" value=system.description enriched=enrichedDescription}}
      </div>
      <div class="description-box">
        <div class="box-title">{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.Special"}}</div>
        {{> "systems/lotm/templates/parts/rich-text.hbs" name="system.special" value=system.special enriched=enrichedSpecial}}
      </div>
    </div>

    {{!-- Details Tab --}}
    <div class="tab details {{tabs.details.cssClass}}" data-group="sheet" data-tab="details">

      <fieldset class="actionType ">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.ActionType"}}</legend>
        <select name="system.actionType" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions config.actionTypes selected=system.actionType localize=true blank=""}}
        </select>
      </fieldset>

      <!--Traits: speech, reaction, grapple, parry, aimed (templates/item/parts/action-traits.hbs)-->
      {{> "systems/lotm/templates/item/parts/action-traits.hbs"}}

      <!--TODO: Put Target, Spirituality Cost, and Range in a sidebar-->
      <!--Target-->
      <fieldset>
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.Target"}}</legend>
        <input id="target" class="blend-input" type="text" name="system.target" value="{{system.target}}" placeholder="{{localize 'LORD_OF_THE_MYSTERIES.ItemSheet.Target'}}" />
      </fieldset>

      <!--Spirituality Cost-->
      <fieldset>
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.SpiritualityCost"}}</legend>
        <input id="spiritualityCost" class="blend-input" type="number" name="system.spiritualityCost" value="{{system.spiritualityCost}}" />
      </fieldset>
      
      <!--Range-->
      <fieldset>
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.Range"}}</legend>
        <input id="range" class="blend-input" type="number" name="system.range" value="{{system.range}}" />
      </fieldset>

      {{!-- Rolls: the same fields as an action (spell.mjs), so a spell rolls like one from the sheets.
            Modifiers, Skill, Attack Roll Macro, Defense Targeted, DC, outcome tables, damage. --}}
      {{> "systems/lotm/templates/item/parts/roll-fields.hbs"}}

      <!--DC Results-->
      <fieldset>
        <legend>{{localize "LORD_OF_THE_MYSTERIES.ItemSheet.DCResults"}}</legend>
        <input id="dcResults" class="blend-input" type="text" name="system.dcResults" value="{{system.dcResults}}" placeholder="{{localize 'LORD_OF_THE_MYSTERIES.ItemSheet.DCResults'}}" />
      </fieldset>

      <!--Sequence Upgrades-->
      {{> "systems/lotm/templates/item/parts/text-rows.hbs" field="system.higherSequenceUpgrades" rows=higherSequenceUpgrades
          class="sequence-upgrades" legend="LORD_OF_THE_MYSTERIES.ItemSheet.SequenceUpgrades" placeholder="LORD_OF_THE_MYSTERIES.ItemSheet.UpgradePlaceholder" addLabel="LORD_OF_THE_MYSTERIES.ItemSheet.AddUpgrade"}}

    </div>

    {{!-- Effects Tab: the item's effects (templates/item/parts/item-effects.hbs) --}}
    <div class="tab effects {{tabs.effects.cssClass}}" data-group="sheet" data-tab="effects">
      {{> "systems/lotm/templates/item/parts/item-effects.hbs"}}
    </div>

  </section>

</div>
