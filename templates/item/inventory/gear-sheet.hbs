{{!-- Gear sheet. Context from LordOfTheMysteriesGearSheet._prepareContext (sheets/item/inventory/inventory-sheets.mjs). --}}
<div class="inventory-sheet">

  <header class="inventory-sheet-header">
    <img class="inventory-sheet-img" src="{{item.img}}" alt="" data-action="editImage" data-tooltip="{{item.name}}">
    <input class="inventory-sheet-name" type="text" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}>
  </header>

  <div class="form-group">
    <label>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Size"}}</label>
    <div class="form-fields">
      <select name="system.size" {{#unless editable}}disabled{{/unless}}>
        {{selectOptions sizeOptions selected=source.size localize=true}}
      </select>
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Quantity"}}</label>
    <div class="form-fields">
      <input type="number" name="system.quantity" value="{{source.quantity}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
    </div>
  </div>

  {{!-- Value of one (value-field.hbs). --}}
  {{> "systems/lotm/templates/item/inventory/value-field.hbs"}}

  {{!-- Purse / wallet: carries cash. Its balances also show in the character's Money panel. --}}
  <div class="form-group">
    <label>{{localize "LORD_OF_THE_MYSTERIES.Money.IsPurse"}}</label>
    <div class="form-fields">
      <input type="checkbox" name="system.isPurse" {{checked source.isPurse}} {{#unless editable}}disabled{{/unless}}>
    </div>
    <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Money.IsPurseHint"}}</p>
  </div>

  {{#if source.isPurse}}
    <fieldset class="purse-money">
      <legend>{{localize "LORD_OF_THE_MYSTERIES.Money.Contents"}}</legend>
      {{#each moneyRows as |row|}}
        <div class="form-group">
          <label>{{localize row.label}}</label>
          <div class="form-fields">
            <input type="text" name="moneyText.{{row.key}}" value="{{row.text}}" {{#unless @root.editable}}disabled{{/unless}}>
          </div>
        </div>
      {{/each}}
      <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Money.AmountHint"}}</p>
    </fieldset>
  {{/if}}

  <dl class="inventory-readout">
    <dt>{{localize "LORD_OF_THE_MYSTERIES.Inventory.SlotsEach"}}</dt><dd>{{slotsEach}}</dd>
    <dt>{{localize "LORD_OF_THE_MYSTERIES.Inventory.SlotsTotal"}}</dt><dd>{{slotsTotal}}</dd>
  </dl>

  {{!-- Where it's carried: only once a character owns it. --}}
  {{#if actor}}
    <div class="form-group">
      <label>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Carried"}}</label>
      <div class="form-fields">
        <select name="system.carry" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions carryOptions selected=source.carry localize=true}}
        </select>
      </div>
    </div>

    {{#if stowed}}
      <div class="form-group">
        <label>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Container"}}</label>
        <div class="form-fields">
          <select name="system.containerId" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions containerOptions selected=source.containerId}}
          </select>
        </div>
      </div>

      <div class="form-group">
        <label>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Hidden"}}</label>
        <div class="form-fields">
          <input type="checkbox" name="system.hidden" {{checked source.hidden}} {{#unless editable}}disabled{{/unless}}>
        </div>
      </div>
    {{/if}}
  {{/if}}

  {{!-- Armor. "Not armor" for everything else. The numbers come from ARMOR_TYPES (inventory-config.mjs),
        worked out in gear.mjs _prepareArmor. --}}
  <div class="form-group">
    <label>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.Kind"}}</label>
    <div class="form-fields">
      <select name="system.armorKind" {{#unless editable}}disabled{{/unless}}>
        {{selectOptions armorOptions selected=source.armorKind localize=true}}
      </select>
    </div>
    {{#if system.isArmor}}<p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.WornHint"}}</p>{{/if}}
  </div>

  {{#if system.isArmor}}
    <dl class="inventory-readout">
      <dt>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.Value"}}</dt>
      <dd>{{system.armorValue}}</dd>

      <dt>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.Reduction"}}</dt>
      <dd>{{#each system.reductionList as |entry|}}{{localize entry.label}} {{entry.value}}{{#unless @last}}, {{/unless}}{{/each}}</dd>

      {{#if system.agilityPenalty}}
        <dt>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.Agility"}}</dt>
        <dd>-{{system.agilityPenalty}}</dd>
      {{/if}}

      {{#if system.strengthNeeds.cannotWear}}
        <dt>{{localize "LORD_OF_THE_MYSTERIES.Attributes.Str.long"}}</dt>
        <dd>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.CannotWear" n=system.strengthNeeds.cannotWear}}</dd>
      {{/if}}
      {{#if system.strengthNeeds.halfMove}}
        <dt>{{localize "LORD_OF_THE_MYSTERIES.Attributes.Str.long"}}</dt>
        <dd>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.HalfMove" n=system.strengthNeeds.halfMove}}</dd>
      {{/if}}
      {{#if system.strengthNeeds.immobile}}
        <dt>{{localize "LORD_OF_THE_MYSTERIES.Attributes.Str.long"}}</dt>
        <dd>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.Immobile" n=system.strengthNeeds.immobile}}</dd>
      {{/if}}

      {{#if system.unprotected.length}}
        <dt>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.Unprotected"}}</dt>
        <dd>{{#each system.unprotected as |location|}}{{localize (concat "LORD_OF_THE_MYSTERIES.Inventory.Armor.Locations." location)}}{{#unless @last}}, {{/unless}}{{/each}}</dd>
      {{/if}}

      {{#if system.destroyed}}
        <dt>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.Condition"}}</dt>
        <dd class="over">{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.Destroyed"}}</dd>
      {{/if}}
    </dl>

    {{!-- Damage the armor has taken. Edited by hand for now; the damage roll will fill these in later. --}}
    {{#if system.fireLimit}}
      <div class="form-group">
        <label>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.FireHits"}}</label>
        <div class="form-fields">
          <input type="number" name="system.armorState.fireHits" value="{{source.armorState.fireHits}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
          <span>/ {{system.fireLimit}}</span>
        </div>
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.FireHitsHint" n=system.fireLimit}}</p>
      </div>
    {{/if}}

    <div class="form-group">
      <label>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.Breach"}}</label>
      <div class="form-fields">
        <select name="system.armorState.breach" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions breachOptions selected=source.armorState.breach localize=true}}
        </select>
      </div>
    </div>

    <div class="form-group">
      <label>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.Expansion"}}</label>
      <div class="form-fields">
        <input type="number" name="system.armorState.expansion" value="{{source.armorState.expansion}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
      </div>
      <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Inventory.Armor.ExpansionHint"}}</p>
    </div>
  {{/if}}

  {{!-- Firearm: holds rounds. The loading / firing is in helpers/firearms.mjs; the rounds are saved on this Item. --}}
  <div class="form-group">
    <label>{{localize "LORD_OF_THE_MYSTERIES.Firearm.IsFirearm"}}</label>
    <div class="form-fields">
      <input type="checkbox" name="system.isFirearm" {{checked source.isFirearm}} {{#unless editable}}disabled{{/unless}}>
    </div>
    <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Firearm.IsFirearmHint"}}</p>
  </div>

  {{#if source.isFirearm}}
    <fieldset class="firearm-settings">
      <legend>{{localize "LORD_OF_THE_MYSTERIES.Firearm.IsFirearm"}}</legend>

      {{!-- How the gun holds its rounds (helpers/gun-feed.mjs). firearm.feed is the one it works like, even before
            one is saved. --}}
      <div class="form-group">
        <label>{{localize "LORD_OF_THE_MYSTERIES.Firearm.Feed.Label"}}</label>
        <div class="form-fields">
          <select name="system.firearm.feed" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions feedOptions selected=firearm.feed localize=true}}
          </select>
        </div>
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Firearm.Feed.Hint"}}</p>
      </div>

      <div class="form-group">
        <label>{{localize "LORD_OF_THE_MYSTERIES.Firearm.Caliber"}}</label>
        <div class="form-fields">
          <input type="text" name="system.firearm.caliber" value="{{source.firearm.caliber}}"
                 placeholder="{{localize 'LORD_OF_THE_MYSTERIES.Firearm.AnyCaliber'}}" {{#unless editable}}disabled{{/unless}}>
        </div>
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Firearm.CaliberHint"}}</p>
      </div>

      <div class="form-group">
        <label>{{localize "LORD_OF_THE_MYSTERIES.Firearm.Capacity"}}</label>
        <div class="form-fields">
          <input type="number" name="system.firearm.capacity" value="{{source.firearm.capacity}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
        </div>
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Firearm.CapacityHint"}}</p>
      </div>

      {{#if (eq firearm.feed "magazine")}}
      <div class="form-group">
        <label>{{localize "LORD_OF_THE_MYSTERIES.Firearm.HasChamber"}}</label>
        <div class="form-fields">
          <input type="checkbox" name="system.firearm.hasChamber" {{checked source.firearm.hasChamber}} {{#unless editable}}disabled{{/unless}}>
        </div>
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Firearm.HasChamberHint"}}</p>
      </div>

      {{#if source.firearm.hasChamber}}
        <div class="form-group">
          <label>{{localize "LORD_OF_THE_MYSTERIES.Firearm.SelfLoading"}}</label>
          <div class="form-fields">
            <input type="checkbox" name="system.firearm.selfLoading" {{checked source.firearm.selfLoading}} {{#unless editable}}disabled{{/unless}}>
          </div>
          <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Firearm.SelfLoadingHint"}}</p>
        </div>
      {{/if}}
      {{/if}}

      {{!-- Handling: what can be done to it besides firing, and how long each takes (helpers/gun-handling.mjs). Each is
            a button on the gun's Shoot row; which ones show depends on the feed. --}}
      <fieldset class="firearm-handling">
        <legend>{{localize "LORD_OF_THE_MYSTERIES.Firearm.Handling.Label"}}</legend>
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Firearm.Handling.Hint"}}</p>
        {{#each handling as |row|}}
        <div class="form-group">
          <label>{{row.label}}</label>
          <div class="form-fields">
            <select name="system.firearm.handling.{{row.use}}.actionType" {{#unless ../editable}}disabled{{/unless}}>
              {{selectOptions ../actionTypeOptions selected=row.actionType localize=true}}
            </select>
          </div>
        </div>
        {{/each}}
        <div class="form-group">
          <label>{{localize "LORD_OF_THE_MYSTERIES.Firearm.Handling.Rounds"}}</label>
          <div class="form-fields">
            <input type="number" name="system.firearm.handling.reload.rounds" value="{{reloadRounds}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
          </div>
          <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Firearm.Handling.RoundsHint"}}</p>
        </div>
      </fieldset>

      {{!-- What's in it right now (firearmStatus in helpers/firearms.mjs). --}}
      <dl class="inventory-readout">
        <dt>{{localize "LORD_OF_THE_MYSTERIES.Firearm.Loaded"}}</dt>
        <dd class="{{#if firearm.empty}}over{{/if}}">{{firearm.label}}</dd>
        <dt>{{localize "LORD_OF_THE_MYSTERIES.Firearm.Next"}}</dt>
        <dd>{{firearm.nextName}}</dd>
      </dl>

      {{!-- Every round (and empty chamber or barrel) in firing order. ✦ = a special round (its ammo has abilities). --}}
      {{#if firearm.rounds.length}}
      <div class="firearm-rounds">
        <div class="firearm-rounds-title">{{localize "LORD_OF_THE_MYSTERIES.Firearm.FiringOrder"}}</div>
        <ol>
          {{#each firearm.rounds as |round|}}
          <li class="{{#if round.empty}}empty{{/if}}{{#if round.next}} next{{/if}}{{#if round.special}} special{{/if}}">
            <span class="firearm-round-position">{{#if round.next}}<i class="fa-solid fa-caret-right"></i>{{/if}}{{round.label}}</span>
            {{#if round.img}}<img src="{{round.img}}" alt="" width="18" height="18">{{/if}}
            <span class="firearm-round-name">{{round.name}}</span>
            {{#if round.special}}<i class="fa-solid fa-star firearm-round-special" data-tooltip="{{localize 'LORD_OF_THE_MYSTERIES.Firearm.Special'}}"></i>{{/if}}
          </li>
          {{/each}}
        </ol>
      </div>
      {{/if}}

      {{!-- The same buttons as on the Shoot row, handy for the GM. They skip the status warnings. Only once a
            character owns the gun. --}}
      {{#if actor}}{{#if editable}}
        <div class="firearm-buttons">
          {{#each handling as |button|}}
            <button type="button" data-action="{{button.sheetAction}}" data-tooltip="{{button.tooltip}}">
              <i class="fa-solid {{#if (eq button.use 'reload')}}fa-box-open{{else if (eq button.use 'chamber')}}fa-circle-dot{{else if (eq button.use 'rotate')}}fa-rotate{{else}}fa-eject{{/if}}"></i>
              {{button.label}}
            </button>
          {{/each}}
        </div>
      {{/if}}{{/if}}
    </fieldset>
  {{/if}}

  {{!-- Ammunition: a box of rounds guns are loaded from. Quantity (above) is the number of boxes. --}}
  <div class="form-group">
    <label>{{localize "LORD_OF_THE_MYSTERIES.Firearm.IsAmmo"}}</label>
    <div class="form-fields">
      <input type="checkbox" name="system.isAmmo" {{checked source.isAmmo}} {{#unless editable}}disabled{{/unless}}>
    </div>
    <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Firearm.IsAmmoHint"}}</p>
  </div>

  {{#if source.isAmmo}}
    <fieldset class="ammo-settings">
      <legend>{{localize "LORD_OF_THE_MYSTERIES.Firearm.IsAmmo"}}</legend>

      <div class="form-group">
        <label>{{localize "LORD_OF_THE_MYSTERIES.Firearm.Caliber"}}</label>
        <div class="form-fields">
          <input type="text" name="system.ammo.caliber" value="{{source.ammo.caliber}}" {{#unless editable}}disabled{{/unless}}>
        </div>
      </div>

      <div class="form-group">
        <label>{{localize "LORD_OF_THE_MYSTERIES.Firearm.PerBox"}}</label>
        <div class="form-fields">
          <input type="number" name="system.ammo.perBox" value="{{source.ammo.perBox}}" min="1" step="1" {{#unless editable}}disabled{{/unless}}>
        </div>
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Firearm.PerBoxHint"}}</p>
      </div>

      {{#if (gt source.ammo.perBox 1)}}
        <div class="form-group">
          <label>{{localize "LORD_OF_THE_MYSTERIES.Firearm.OpenBox"}}</label>
          <div class="form-fields">
            <input type="number" name="system.ammo.rounds" value="{{source.ammo.rounds}}" min="0" max="{{source.ammo.perBox}}" step="1" {{#unless editable}}disabled{{/unless}}>
          </div>
        </div>
      {{/if}}

      <dl class="inventory-readout">
        <dt>{{localize "LORD_OF_THE_MYSTERIES.Firearm.Total"}}</dt>
        <dd class="{{#if ammoBox.empty}}over{{/if}}">{{ammoBox.label}}</dd>
      </dl>
    </fieldset>
  {{/if}}

  {{!-- What this item grants. Drop abilities / actions from the sidebar or a compendium onto each list.
        The drop handling is in LordOfTheMysteriesGearSheet._onRender. --}}
  {{#each grantLists as |list|}}
    <div class="gear-grants" data-grant-list="{{list.key}}">
      <header class="gear-grants-header">
        <h4>{{localize list.label}}</h4>
        {{#if @root.editable}}<span class="hint">{{localize list.hint}}</span>{{/if}}
      </header>
      {{#if list.entries.length}}
        <ul class="inventory-contents">
          {{#each list.entries as |entry|}}
            <li>
              <img src="{{entry.img}}" alt="">
              {{#if entry.broken}}
                <span class="name">{{entry.name}}</span>
              {{else}}
                <a class="name" data-action="openGrant" data-uuid="{{entry.uuid}}">{{entry.name}}</a>
              {{/if}}
              {{#if @root.editable}}
                <button type="button" class="gear-grant-remove" data-action="removeGrant" data-list="{{list.key}}" data-uuid="{{entry.uuid}}"
                        data-tooltip="LORD_OF_THE_MYSTERIES.Drop.Remove" aria-label="{{localize 'LORD_OF_THE_MYSTERIES.Drop.Remove'}}">
                  <i class="fa-solid fa-trash"></i>
                </button>
              {{/if}}
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="hint">{{localize "LORD_OF_THE_MYSTERIES.Drop.Empty"}}</p>
      {{/if}}
    </div>
  {{/each}}

  {{!-- The gear's effects (templates/item/parts/item-effects.hbs). Passive ones only apply while it's held or worn. --}}
  {{> "systems/lotm/templates/item/parts/item-effects.hbs"}}

  <div class="form-group stacked">
    <label>{{localize "LORD_OF_THE_MYSTERIES.Inventory.Description"}}</label>
    <textarea name="system.description" {{#unless editable}}disabled{{/unless}}>{{source.description}}</textarea>
  </div>
</div>
