{{!-- NPC header: portrait, name, the strongest Sequence (worked out by NpcSheet.#sequenceLine), organization,
     and how it looks to Spirit Vision / Death Vision (system.spirit, see canvas/spirit-aura.mjs). --}}
<header class="npc-header">
  <div class="portrait-box npc-portrait">
    <img class="portrait-img" src="{{actor.img}}" data-edit="img" data-action="editImage" alt="{{actor.name}}" />
  </div>

  <div class="npc-header-info">
    <input class="npc-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'LORD_OF_THE_MYSTERIES.NPC.Name'}}" />
    <div class="npc-header-row">
      <span class="npc-sequence-line" data-tooltip="LORD_OF_THE_MYSTERIES.NPC.SequenceLineHint">
        <i class="fa-solid fa-flask"></i> {{sequenceLine}}
      </span>
      <label class="npc-organization">
        <span>{{localize "LORD_OF_THE_MYSTERIES.NPC.Organization"}}</span>
        <input type="text" name="system.organization" value="{{system.organization}}"
               placeholder="{{localize 'LORD_OF_THE_MYSTERIES.NPC.OrganizationPlaceholder'}}" />
      </label>
    </div>
    <div class="npc-header-row npc-spirit-row">
      <label class="npc-spirit-aura" data-tooltip="LORD_OF_THE_MYSTERIES.NPC.SpiritAuraHint">
        <i class="fa-solid fa-eye"></i>
        <span>{{localize "LORD_OF_THE_MYSTERIES.NPC.SpiritAura"}}</span>
        <color-picker name="system.spirit.auraColor" value="{{system.spirit.auraColor}}"></color-picker>
      </label>
      <label class="npc-spirit-undead" data-tooltip="LORD_OF_THE_MYSTERIES.NPC.UndeadHint">
        <input type="checkbox" name="system.spirit.isUndead" {{checked system.spirit.isUndead}} />
        <span>{{localize "LORD_OF_THE_MYSTERIES.NPC.Undead"}}</span>
      </label>
    </div>
  </div>
</header>
