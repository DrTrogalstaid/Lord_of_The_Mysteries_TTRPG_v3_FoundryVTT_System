<aside class="sheet-sidebar">


  <div class="pool-container">
    <div class="pool-row">
      <div class="pool-box">
        <label>Health</label>
        <div class="pool-values">
          <input type="number" name="system.resources.hp.value" value="{{system.resources.hp.value}}" />
          <span class="pool-sep">/</span>
          <input type="number" name="system.resources.hp.max" value="{{system.resources.hp.max}}" readonly/>
        </div>
        {{!-- Wounds treated with a Medicine check: Long Rest heals Physique instead of half. Cleared by Long Rest. --}}
        <label class="pool-flag" data-tooltip="{{localize 'LORD_OF_THE_MYSTERIES.Recovery.TreatedHint'}}">
          <input type="checkbox" name="system.hasBeenTreated" {{checked system.hasBeenTreated}} />
          {{localize "LORD_OF_THE_MYSTERIES.Recovery.Treated"}}
        </label>
      </div>
      <div class="pool-box">
        <label>Sanity</label>
        <div class="pool-values">
          <input type="number" name="system.resources.rp.value" value="{{system.resources.rp.value}}" />
          <span class="pool-sep">/</span>
          <input type="number" name="system.resources.rp.max" value="{{system.resources.rp.max}}" readonly/>
        </div>
        <button type="button" class="spend-btn" data-action="sanityCheck"
                data-tooltip="{{localize 'LORD_OF_THE_MYSTERIES.Sanity.ButtonHint'}}">{{localize "LORD_OF_THE_MYSTERIES.Sanity.Button"}}</button>
      </div>
    </div>
  </div>

  <!--Long and Short Rrest-->
  <div class="rest-row">
    <button type="button" class="rest-btn" data-action="shortRest">Short<br />Rest</button>
    <button type="button" class="rest-btn" data-action="longRest">Long<br />Rest</button>
  </div>

  <!--Defense -->
  <div class="defense-box">
    <div class="stat-box full-width{{#if statusNotes.physical}} status-modified{{/if}}"{{#if statusNotes.physical}} data-tooltip="{{statusNotes.physical}}"{{/if}}>
      <label>Physical</label>
      <input type="number" name="system.defenses.physical" value="{{system.defenses.physical}}" readonly/>
      <label class="pool-flag" data-tooltip="{{localize 'LORD_OF_THE_MYSTERIES.QuickDodge.Hint'}}">
        <input type="checkbox" name="system.isQuickDodgable" {{checked system.isQuickDodgable}} />
        {{localize "LORD_OF_THE_MYSTERIES.QuickDodge.Label"}}
      </label>
    </div>
    <div class="pool-row">
      <div class="stat-box">
        <label>Physique</label>
        <input type="number" name="system.defenses.physique" value="{{system.defenses.physique}}" readonly/>
      </div>
      <div class="stat-box">
        <label>Will</label>
        <input type="number" name="system.defenses.wil", value="{{system.defenses.will}}" readonly/>
      </div>
    </div>
    {{> "systems/lotm/templates/actor/parts/damage-defenses.hbs"}}
  </div>

  <!--Movement-->
  <div class="speed-container">
    <div class="speed-box full-width{{#if statusNotes.movement}} status-modified{{/if}}"{{#if statusNotes.movement}} data-tooltip="{{statusNotes.movement}}"{{/if}}>
      <label>Movement Speed</label>
      <input type="number" name="system.movement", value="{{system.movement}}" readonly>
    </div>
  </div>

  <!--Spirit and Luck-->
  <div class="pool-row">
    <div class="pool-box">
      <label>Spirituality</label>
      <div class="pool-values">
        <input type="number" name="system.resources.spp.value" value="{{system.resources.spp.value}}"/>
        <span class="pool-sep">/</span>
        <input type="number" name="system.resources.spp.max" value="{{system.resources.spp.max}}" readonly/>
      </div>
      <button type="button" class="spend-btn" data-action="spendSpirituality">Spend</button>
    </div>
    <div class="pool-box">
      <label>Luck</label>
      <div class="pool-values">
        <input type="number" name="system.resources.lp.value" value="{{system.resources.lp.value}}"/>
        <span class="pool-sep">/</span>
        <input type="number" name="system.resources.lp.max" value="{{system.resources.lp.max}}" readonly/>
      </div>
      <button type="button" class="spend-btn" data-action="spendLuck">Spend</button>
    </div>
  </div>

</aside>
