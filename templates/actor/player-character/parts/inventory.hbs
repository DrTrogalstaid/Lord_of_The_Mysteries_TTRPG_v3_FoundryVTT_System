<section class="tab inventory-tab {{tab.cssClass}}" data-group="sheet" data-tab="inventory">

  {{!-- Totals: the Strength limit and the room in pockets and bags. Built by buildInventoryView() in helpers/inventory.mjs. --}}
  <div class="inventory-summary">
    <div class="inventory-meter{{#if inventory.summary.overloaded}} over{{/if}}">
      <span class="inventory-meter-label">{{localize "LORD_OF_THE_MYSTERIES.Inventory.Carrying"}}</span>
      <span class="inventory-meter-value">{{inventory.summary.carried}} / {{inventory.summary.strength}}</span>
      <span class="inventory-meter-hint">{{localize "LORD_OF_THE_MYSTERIES.Inventory.StrengthLimit"}}</span>
    </div>
    <div class="inventory-meter{{#if inventory.summary.stowedOver}} over{{/if}}">
      <span class="inventory-meter-label">{{localize "LORD_OF_THE_MYSTERIES.Inventory.Stowed"}}</span>
      <span class="inventory-meter-value">{{inventory.summary.stowed}} / {{inventory.summary.capacity}}</span>
      <span class="inventory-meter-hint">{{localize "LORD_OF_THE_MYSTERIES.Inventory.StowedHint"}}</span>
    </div>
  </div>

  {{#each inventory.summary.warnings as |warning|}}
    <p class="inventory-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{warning}}</p>
  {{/each}}

  {{!-- Money: cash in carried purses, deposits kept elsewhere, and buttons to change them.
        Built by buildMoneyView() in helpers/currency.mjs; the buttons open its transaction dialog. --}}
  <section class="money-panel">
    <header class="money-header">
      <h3 class="money-title"><i class="fa-solid fa-coins"></i> {{localize "LORD_OF_THE_MYSTERIES.Money.Title"}}</h3>
      <span class="money-worth" data-tooltip="{{money.worthTooltip}}">
        {{localize "LORD_OF_THE_MYSTERIES.Money.Worth"}} <strong>{{money.worth}}</strong>
      </span>
      {{#if editable}}
        <div class="money-actions">
          <button type="button" data-action="moneyTransaction" data-mode="receive"><i class="fa-solid fa-plus"></i> {{localize "LORD_OF_THE_MYSTERIES.Money.Modes.receive"}}</button>
          <button type="button" data-action="moneyTransaction" data-mode="pay"><i class="fa-solid fa-minus"></i> {{localize "LORD_OF_THE_MYSTERIES.Money.Modes.pay"}}</button>
          <button type="button" data-action="moneyTransaction" data-mode="move"><i class="fa-solid fa-right-left"></i> {{localize "LORD_OF_THE_MYSTERIES.Money.Modes.move"}}</button>
          <button type="button" data-action="moneyTransaction" data-mode="exchange"><i class="fa-solid fa-scale-balanced"></i> {{localize "LORD_OF_THE_MYSTERIES.Money.Modes.exchange"}}</button>
        </div>
      {{/if}}
    </header>

    <div class="money-columns">
      <div class="money-box">
        <span class="money-box-label">{{localize "LORD_OF_THE_MYSTERIES.Money.OnPerson"}}</span>
        <span class="money-box-value">{{money.onPerson}}</span>
        {{#if money.noPurse}}
          <span class="money-box-hint">{{localize "LORD_OF_THE_MYSTERIES.Money.NoPurse"}}</span>
        {{else}}
          <ul class="money-purses">
            {{#each money.purses as |purse|}}
              <li class="{{#unless purse.carried}}left-behind{{/unless}}">
                <a data-action="openItem" data-uuid="{{purse.uuid}}">{{purse.name}}</a>
                {{#unless purse.carried}}<span class="money-tag">{{localize "LORD_OF_THE_MYSTERIES.Money.LeftBehind"}}</span>{{/unless}}
                <span class="money-purse-balance">{{purse.balance}}</span>
              </li>
            {{/each}}
          </ul>
        {{/if}}
      </div>
      <div class="money-box">
        <span class="money-box-label">{{localize "LORD_OF_THE_MYSTERIES.Money.Stored"}}</span>
        <span class="money-box-value">{{money.stored}}</span>
        <span class="money-box-hint">{{localize "LORD_OF_THE_MYSTERIES.Money.StoredHint"}}</span>
      </div>
    </div>
  </section>

  {{!-- One drop section for the whole tab, so drops and the move buttons work like the other tabs.
        Each group inside is its own list; data-inventory-place says where gear dropped on it goes. --}}
  <div class="drop-section inventory-section" data-drop-zone="inventory">
    <header class="drop-section-header">
      <h3 class="drop-section-title">{{localize "LORD_OF_THE_MYSTERIES.Drop.Sections.inventory"}}</h3>
      {{#if editable}}
        <span class="drop-section-hint">{{localize "LORD_OF_THE_MYSTERIES.Inventory.DropHint"}}</span>
        {{!-- New blank gear or clothing / bag (PlayerCharacterSheet.#onAddItem). --}}
        <button type="button" class="drop-section-add" data-action="addItem" data-tooltip="LORD_OF_THE_MYSTERIES.Inventory.Add.Title" aria-label="{{localize 'LORD_OF_THE_MYSTERIES.Inventory.Add.Title'}}">
          <i class="fa-solid fa-plus"></i>
        </button>
      {{/if}}
    </header>

    {{#if inventory.noContainers}}
      <p class="inventory-hint">{{localize "LORD_OF_THE_MYSTERIES.Inventory.NoContainers"}}</p>
    {{/if}}

    {{#each inventory.groups as |group|}}
      <div class="inventory-group{{#if group.container}} inventory-container{{/if}}{{#if group.leftBehind}} left-behind{{/if}}{{#if group.full}} over{{/if}}"
           {{#if group.place}}data-inventory-place="{{group.place}}"{{/if}}>

        <header class="inventory-group-header">
          {{#if group.container}}
            {{!-- A coat or bag: the image posts it to chat (same button as the item rows), its name opens its sheet. --}}
            <button type="button" class="drop-entry-icon inventory-group-icon" data-action="sendToChat" data-uuid="{{group.uuid}}" data-tooltip="Send to chat">
              <img class="drop-entry-img" src="{{group.img}}" alt="" width="28" height="28">
              <span class="drop-entry-icon-overlay"><i class="fa-solid fa-comment"></i></span>
            </button>
            <div class="inventory-group-main">
              <a class="drop-entry-name" data-action="openItem" data-uuid="{{group.uuid}}">{{group.name}}</a>
              <span class="drop-entry-detail">
                {{group.kindLabel}}{{#if group.drawLabel}} · {{group.drawLabel}}{{/if}}{{#if group.valueLabel}} · {{group.valueLabel}}{{/if}}{{#if group.leftBehind}} · {{localize "LORD_OF_THE_MYSTERIES.Inventory.LeftBehind"}}{{/if}}
              </span>
            </div>
            <div class="inventory-group-stats">
              {{#if group.warning}}
                <span class="inventory-stat over" data-tooltip="{{group.warning}}"><i class="fa-solid fa-triangle-exclamation"></i></span>
              {{/if}}
              <span class="inventory-stat{{#if group.full}} over{{/if}}" data-tooltip="LORD_OF_THE_MYSTERIES.Inventory.Slots">
                {{group.used}} / {{group.capacity}}
              </span>
              {{#if group.hiddenCapacity}}
                <span class="inventory-stat{{#if group.hiddenFull}} over{{/if}}" data-tooltip="LORD_OF_THE_MYSTERIES.Inventory.HiddenPockets">
                  <i class="fa-solid fa-eye-slash"></i> {{group.hiddenUsed}} / {{group.hiddenCapacity}}
                </span>
              {{/if}}
              {{#if group.combatPenalty}}
                <span class="inventory-stat warn" data-tooltip="LORD_OF_THE_MYSTERIES.Inventory.Warnings.Suitcase">
                  <i class="fa-solid fa-suitcase"></i> {{group.combatPenalty}}
                </span>
              {{/if}}
            </div>
            {{#if @root.editable}}
              <label class="inventory-equip" data-tooltip="LORD_OF_THE_MYSTERIES.Inventory.Equipped">
                <input type="checkbox" data-item-field="system.equipped" data-item-id="{{group.id}}" {{checked group.equipped}}>
                <i class="fa-solid fa-shirt"></i>
              </label>
              <button type="button" class="drop-entry-remove" data-action="deleteItem" data-item-id="{{group.id}}" data-tooltip="LORD_OF_THE_MYSTERIES.Drop.Remove" aria-label="{{localize 'LORD_OF_THE_MYSTERIES.Drop.Remove'}}">
                <i class="fa-solid fa-trash"></i>
              </button>
            {{/if}}
          {{else}}
            {{!-- Held & worn / Not stowed / Other items --}}
            <h4 class="inventory-group-title">{{group.name}}</h4>
            {{#if group.hint}}<span class="inventory-group-hint">{{group.hint}}</span>{{/if}}
            {{#if group.warning}}
              <span class="inventory-stat over" data-tooltip="{{group.warning}}"><i class="fa-solid fa-triangle-exclamation"></i></span>
            {{/if}}
          {{/if}}
        </header>

        {{#if group.entries.length}}
          <ol class="drop-section-list">
            {{#each group.entries as |entry|}}
              {{> "systems/lotm/templates/actor/player-character/parts/drop-entry.hbs" entry deleteAction="deleteItem"}}
            {{/each}}
          </ol>
        {{else}}
          <p class="drop-section-empty">{{group.emptyText}}</p>
        {{/if}}
      </div>
    {{/each}}
  </div>
</section>
