<section class="pc-header-box">

  <div class="name-row">
    <label for="actor-name">Name:</label>
    <input id="actor-name" type="text" name="name" value="{{actor.name}}" placeholder="Name" />
  </div>

  <div class="header-rows">
    
    <div class="portrait-box">
      <img class="portrait-img" src="{{actor.img}}" data-edit="img" data-action="editImage" alt="{{actor.name}}" />
    </div>

    <div class="header-main">

      <div class="header-info">

        <div class="sequence-row">
          <span class="sequence-title-label">Sequence Title:</span>
          {{!-- Filled in from the character's lowest-numbered Sequence (_currentSequence in base-actor-sheet.mjs).
                Change it by adding or removing Sequences on the Sequences tab. --}}
          {{#if currentSequence}}
          <span class="sequence-title-value">{{currentSequence.name}}</span>
          <span class="pathway-label">(Sequence {{currentSequence.number}}{{#if currentSequence.pathway}} · {{currentSequence.pathway}}{{/if}})</span>
          {{else}}
          <span class="sequence-title-value none">{{localize "LORD_OF_THE_MYSTERIES.NPC.NoSequence"}}</span>
          {{/if}}
        </div>

        <div class="basic-info-row">
          <div class="info-field">
            <label>Age:</label>
            <input type="number" name="system.age" value="{{system.age}}" />
          </div>
          <div class="info-field">
            <label>Occupation:</label>
            <input type="text" name="system.occupation" value="{{system.occupation}}" />
          </div>
          <div class="info-field">
            <label>Race:</label>
            <input type="text" name="system.race" value="{{system.race}}" />
          </div>
          <div class="info-field">
            <label>Gender:</label>
            <input type="text" name="system.gender" value="{{system.gender}}" />
          </div>
        </div>

      </div>

    </div>

  </div>


</section>
