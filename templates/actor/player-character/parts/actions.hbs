<section class="tab actions-tab {{tab.cssClass}}" data-group="sheet" data-tab="actions">

  {{!-- One drop section for the whole tab, so dropping an action anywhere on it works like before.
        Inside it: Favorites, then one collapsible section per action type.
        Built by groupActions() in player-character-sheet.mjs; each row is section-entry.hbs. --}}
  <div class="drop-section actions-section" data-drop-zone="actions">
    <header class="drop-section-header">
      <h3 class="drop-section-title">{{localize "LORD_OF_THE_MYSTERIES.Drop.Sections.actions"}}</h3>
      {{#if editable}}
        <span class="drop-section-hint">{{localize "LORD_OF_THE_MYSTERIES.Drop.Hint"}}</span>
        <button type="button" class="drop-section-add" data-action="addAction" data-tooltip="LORD_OF_THE_MYSTERIES.Drop.Add" aria-label="{{localize 'LORD_OF_THE_MYSTERIES.Drop.Add'}}">
          <i class="fa-solid fa-plus"></i>
        </button>
      {{/if}}
    </header>

    {{#each actionGroups as |group|}}
      {{!-- <details> opens and closes by itself when its <summary> is clicked. The sheet remembers which ones
            this player closed (#saveCollapsedGroups), so it only needs to leave "open" off those. --}}
      <details class="action-group{{#if group.favorites}} favorites{{/if}}" data-action-group="{{group.key}}"{{#unless group.collapsed}} open{{/unless}}>
        <summary class="action-group-header">
          <i class="fa-solid fa-chevron-right action-group-chevron"></i>
          {{#if group.favorites}}<i class="fa-solid fa-star action-group-star"></i>{{/if}}
          <span class="action-group-title">{{group.label}}</span>
          <span class="action-group-count">{{group.entries.length}}</span>
        </summary>

        {{#if group.entries.length}}
          {{!-- data-favorites: the move buttons in this list reorder Favorites, not the type sections (#onMoveEntry). --}}
          <ol class="drop-section-list"{{#if group.favorites}} data-favorites{{/if}}>
            {{#each group.entries as |entry|}}
              {{> "systems/lotm/templates/actor/player-character/parts/section-entry.hbs" entry remove="deleteAction" favorites=true}}
            {{/each}}
          </ol>
        {{else}}
          <p class="drop-section-empty">{{group.emptyText}}</p>
        {{/if}}
      </details>
    {{else}}
      <p class="drop-section-empty">{{localize "LORD_OF_THE_MYSTERIES.Drop.Empty"}}</p>
    {{/each}}
  </div>
</section>
