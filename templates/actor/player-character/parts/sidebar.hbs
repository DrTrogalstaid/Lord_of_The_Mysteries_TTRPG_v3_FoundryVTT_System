<aside class="sheet-sidebar">


  <div class="pool-container">
    <div class="pool-row">
      <div class="pool-box">
        <label>Health</label>
        <div class="pool-values">
          <input type="number" name="system.resources.hp.value" value="{{system.resources.hp.value}}" />
          <span class="pool-sep">/</span>
          <input type="number" name="system.resources.hp.max" value="{{system.resources.hp.max}}" readonly/>
        </div>
      </div>
    </div>
    <div class="pool-row">
      <div class="pool-box">
        <label>Rationality</label>
        <div class="pool-values">
          <input type="number" name="system.resources.rp.value" value="{{system.resources.rp.value}}" />
          <span class="pool-sep">/</span>
          <input type="number" name="system.resources.rp.max" value="{{system.resources.rp.max}}" readonly/>
        </div>
      </div>
    </div>
  </div>

  <!--Long and Short Rrest-->
  <div class="rest-row">
    <button type="button" class="rest-btn" data-action="shortRest">Short<br />Rest</button>
    <button type="button" class="rest-btn" data-action="longRest">Long<br />Rest</button>
  </div>

  <!--Defense -->
  <div class="defense-box">
    <div class="stat-box full-width">
      <label>Physical</label>
      <input type="number" name="system.defenses.physical" value="{{system.defenses.physical}}" readonly/>
    </div>
    <div class="pool-row">
      <div class="stat-box">
        <label>Physique</label>
        <input type="number" name="system.defenses.physique" value="{{system.defenses.physique}}" readonly/>
      </div>
      <div class="stat-box">
        <label>Will</label>
        <input type="number" name="system.defenses.wil", value="{{system.defenses.will}}" readonly/>
      </div>
    </div>
    <div class="stat-box full-width damage-resistance-box">
      <label>Damage Resistance</label>
      <!--TODO: Base this off of the Sequence sheet attribute gain section-->
      <ul class="damage-resistance-list">
        {{#each system.damage_resistance as |row|}}
        <li class="damage-resistance-row">
          <select class="damage-resistance-type" name="system.damage_resistance.{{@index}}.damage_type">
            {{selectOptions @root.damageTypeChoices selected=row.damage_type}}
          </select>
          <input
            type="number"
            class="damage-resistance-value"
            name="system.damage_resistance.{{@index}}.value"
            value="{{row.value}}"
            min="0"
          />
          <a class="damage-resistance-remove" data-action="removeDamageResistance" data-index="{{@index}}"
             title="{{localize 'LORD_OF_THE_MYSTERIES.DamageResistance.Remove'}}">
            <i class="fas fa-trash"></i>
          </a>
        </li>
        {{/each}}
      </ul>
      <button type="button" class="damage-resistance-add-button" data-action="addDamageResistance"
              title="{{localize 'LORD_OF_THE_MYSTERIES.DamageResistance.Add'}}">
        <i class="fa-solid fa-plus"></i> {{localize "LORD_OF_THE_MYSTERIES.DamageResistance.Add"}}
      </button>
    </div>
  </div>

  <!--Movement-->
  <div class="speed-container">
    <div class="speed-box full-width">
      <label>Movement Speed</label>
      <input type="number" name="system.movement", value="{{system.movement}}" readonly>
    </div>
  </div>

  <!--Spirit and Luck-->
  <div class="pool-row">
    <div class="pool-box">
      <label>Spirituality</label>
      <div class="pool-values">
        <input type="number" name="system.resources.spp.value" value="{{system.resources.spp.value}}" readonly/>
        <span class="pool-sep">/</span>
        <input type="number" name="system.resources.spp.max" value="{{system.resources.spp.max}}" readonly/>
      </div>
      <button type="button" class="spend-btn" data-action="spendSpirituality">Spend</button>
    </div>
    <div class="pool-box">
      <label>Luck</label>
      <div class="pool-values">
        <input type="number" name="system.resources.lp.value" value="{{system.resources.lp.value}}" readonly/>
        <span class="pool-sep">/</span>
        <input type="number" name="system.resources.lp.max" value="{{system.resources.lp.max}}" readonly/>
      </div>
      <button type="button" class="spend-btn" data-action="spendLuck">Spend</button>
    </div>
  </div>

</aside>
