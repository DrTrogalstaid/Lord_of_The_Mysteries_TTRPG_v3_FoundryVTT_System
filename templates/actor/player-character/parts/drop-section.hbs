{{!--
  One drop section: a titled box that accepts Items of a single kind, listing the ones the actor owns
  plus the ones granted by other Items.

  Call it from the root scope of a part template:
    {{> "systems/lotm/templates/actor/player-character/parts/drop-section.hbs"
        zone="abilities" label="LORD_OF_THE_MYSTERIES.Drop.Sections.abilities"
        entries=sections.abilities remove="deleteAbility" add="addAbility"}}

  zone     Key matching DROP_SECTIONS in player-character-sheet.mjs (read back from data-drop-zone on drop).
  label    Localization key for the title.
  entries  Array from context.sections.<zone>.
  remove   data-action for the delete button (owned entries only).
  add      Optional data-action for the "+" button.

  Action entries (entry.isAction) get extra fields (buildEntry / #addActionButtons in player-character-sheet.mjs):
    entry.attack   { label, bonusLabel, tooltip }  the attack button ("Pistol +5"). Empty = no skill set.
    entry.damage   { tooltip }                     the damage button. Empty = no damage formula.
    entry.hasRolls                                 true when there's at least one of the two buttons.
    entry.rangeLabel                               the Range stat ("30 ft", blank when unset).
--}}
<div class="drop-section" data-drop-zone="{{zone}}">
  <header class="drop-section-header">
    <h3 class="drop-section-title">{{localize label}}</h3>
    {{#if editable}}
      <span class="drop-section-hint">{{localize "LORD_OF_THE_MYSTERIES.Drop.Hint"}}</span>
      {{#if add}}
        <button type="button" class="drop-section-add" data-action="{{add}}" data-tooltip="LORD_OF_THE_MYSTERIES.Drop.Add" aria-label="{{localize 'LORD_OF_THE_MYSTERIES.Drop.Add'}}">
          <i class="fa-solid fa-plus"></i>
        </button>
      {{/if}}
    {{/if}}
  </header>

  {{#if entries.length}}
    <ol class="drop-section-list">
      {{#each entries as |entry|}}
        <li class="drop-entry{{#if entry.nested}} granted{{/if}}{{#if entry.broken}} broken{{/if}}{{#if entry.isAction}} action{{/if}}" data-key="{{entry.key}}" data-uuid="{{entry.uuid}}" data-item-id="{{entry.id}}">
          {{#if entry.broken}}
            <span class="drop-entry-icon">
              <img class="drop-entry-img" src="{{entry.img}}" alt="" width="28" height="28">
            </span>
          {{else}}
            <button type="button" class="drop-entry-icon" data-action="sendToChat" data-uuid="{{entry.uuid}}">
              <img class="drop-entry-img" src="{{entry.img}}" alt="" width="28" height="28">
              <span class="drop-entry-icon-overlay"><i class="fa-solid fa-comment"></i></span>
            </button>
          {{/if}}

          <div class="drop-entry-main">
            <div class="drop-entry-title-row">
              {{#if entry.broken}}
                <span class="drop-entry-name">{{entry.name}}</span>
              {{else}}
                <a class="drop-entry-name" data-action="openItem" data-uuid="{{entry.uuid}}">{{entry.name}}</a>
              {{/if}}
              {{#if entry.grantedByLabel}}
                <span class="drop-entry-source">{{localize "LORD_OF_THE_MYSTERIES.Drop.GrantedBy"}} {{entry.grantedByLabel}}</span>
              {{/if}}
            </div>
            {{#if entry.detail}}
              <span class="drop-entry-detail">{{entry.detail}}</span>
            {{/if}}

            {{!-- Action buttons, pf2e style: [d20 Pistol +5] [Damage]. Hidden on broken entries. --}}
            {{#unless entry.broken}}
              {{#if entry.isAction}}
                {{#if entry.hasRolls}}
                  <div class="drop-entry-rolls">
                    {{#if entry.attack}}
                      {{!-- Opens the skill check dialog (PlayerCharacterSheet.#onRollAction). --}}
                      <button type="button" class="drop-entry-roll-btn attack" data-action="rollAction" data-uuid="{{entry.uuid}}"
                              data-gun-id="{{entry.gunId}}" data-tooltip="{{entry.attack.tooltip}}">
                        <i class="fa-solid fa-dice-d20"></i>
                        <span class="drop-entry-roll-label">{{entry.attack.label}}</span>
                        <span class="drop-entry-roll-bonus">{{entry.attack.bonusLabel}}</span>
                      </button>
                    {{/if}}
                    {{#if entry.damage}}
                      {{!-- Hover shows what will be rolled, e.g. "2d6+1 Piercing" (getDamageTooltip in action-roll.mjs). --}}
                      <button type="button" class="drop-entry-roll-btn damage" data-action="rollDamage" data-uuid="{{entry.uuid}}"
                              data-tooltip="{{entry.damage.tooltip}}">
                        {{localize "LORD_OF_THE_MYSTERIES.Drop.Damage"}}
                      </button>
                    {{/if}}
                    {{!-- Reload / Chamber / Unload (PlayerCharacterSheet.#onUseAmmo -> useAmmoAction in helpers/firearms.mjs).
                          A reload action gets two: Reload and Unload. --}}
                    {{#each entry.ammoButtons as |button|}}
                      <button type="button" class="drop-entry-roll-btn ammo" data-action="useAmmo" data-uuid="{{entry.uuid}}"
                              data-gun-id="{{entry.gunId}}" data-ammo-use="{{button.use}}"{{#if button.disabled}} disabled{{/if}}>
                        <i class="fa-solid {{#if (eq button.use 'unload')}}fa-eject{{else}}fa-gun{{/if}}"></i>
                        <span class="drop-entry-roll-label">{{button.label}}</span>
                      </button>
                    {{/each}}
                    {{#if entry.gunStatus}}
                      {{!-- Rounds in the magazine, and (for guns with one) a filled / hollow dot for the chamber. Hover for what's loaded. --}}
                      <span class="drop-entry-gun-status{{#if entry.gunStatus.empty}} empty{{/if}}" data-tooltip="{{entry.gunStatus.tooltip}}">
                        <i class="fa-solid fa-gun"></i> {{entry.gunStatus.label}}
                        {{#if entry.gunStatus.hasChamber}}
                          <i class="{{#if entry.gunStatus.chambered}}fa-solid{{else}}fa-regular{{/if}} fa-circle chamber-dot"></i>
                        {{/if}}
                      </span>
                    {{/if}}
                  </div>
                {{/if}}
              {{/if}}
            {{/unless}}
          </div>

          {{!-- Stats on the right. Actions always show all three, so the columns line up row to row. --}}
          {{#if entry.isAction}}
            <div class="drop-entry-stats">
              <div class="drop-entry-stat drop-entry-action-type">
                <span class="drop-entry-stat-label">{{localize "LORD_OF_THE_MYSTERIES.Drop.ActionType"}}</span>
                <span class="drop-entry-stat-value">{{entry.actionTypeLabel}}</span>
              </div>
              <div class="drop-entry-stat drop-entry-cost">
                <span class="drop-entry-stat-label">{{localize "LORD_OF_THE_MYSTERIES.Drop.Cost"}}</span>
                <span class="drop-entry-stat-value">{{entry.cost}}</span>
              </div>
              <div class="drop-entry-stat drop-entry-range">
                <span class="drop-entry-stat-label">{{localize "LORD_OF_THE_MYSTERIES.Drop.Range"}}</span>
                <span class="drop-entry-stat-value">{{entry.rangeLabel}}</span>
              </div>
            </div>
          {{else if entry.hasStats}}
            <div class="drop-entry-stats">
              {{#if entry.actionTypeLabel}}
                <div class="drop-entry-stat drop-entry-action-type">
                  <span class="drop-entry-stat-label">{{localize "LORD_OF_THE_MYSTERIES.Drop.ActionType"}}</span>
                  <span class="drop-entry-stat-value">{{entry.actionTypeLabel}}</span>
                </div>
              {{/if}}
              {{#if entry.hasCost}}
                <div class="drop-entry-stat drop-entry-cost">
                  <span class="drop-entry-stat-label">{{localize "LORD_OF_THE_MYSTERIES.Drop.Cost"}}</span>
                  <span class="drop-entry-stat-value">{{entry.cost}}</span>
                </div>
              {{/if}}
              {{#if entry.hasDigestion}}
                <div class="drop-entry-stat drop-entry-digestion-stat">
                  <span class="drop-entry-stat-label">{{localize "LORD_OF_THE_MYSTERIES.Drop.Digestion"}}</span>
                  {{#if ../editable}}
                    {{#if entry.owned}}
                      <input type="number" class="drop-entry-digestion" min="1" max="20" step="1"
                             value="{{entry.digestion}}" data-digestion-input data-item-id="{{entry.id}}"
                             data-tooltip="LORD_OF_THE_MYSTERIES.Drop.DigestionHint">
                    {{else}}
                      <span class="drop-entry-stat-value">{{entry.digestion}}</span>
                    {{/if}}
                  {{else}}
                    <span class="drop-entry-stat-value">{{entry.digestion}}</span>
                  {{/if}}
                </div>
              {{/if}}
            </div>
          {{/if}}

          {{#if ../editable}}
            {{#if entry.canMove}}
              <div class="drop-entry-move">
                <button type="button" class="drop-entry-move-btn" data-action="moveEntry" data-direction="up" data-key="{{entry.key}}"{{#unless entry.canMoveUp}} disabled{{/unless}}>
                  <i class="fa-solid fa-chevron-up"></i>
                </button>
                <button type="button" class="drop-entry-move-btn" data-action="moveEntry" data-direction="down" data-key="{{entry.key}}"{{#unless entry.canMoveDown}} disabled{{/unless}}>
                  <i class="fa-solid fa-chevron-down"></i>
                </button>
              </div>
            {{/if}}
            {{#if entry.owned}}
              <button type="button" class="drop-entry-remove" data-action="{{../remove}}" data-item-id="{{entry.id}}" data-tooltip="LORD_OF_THE_MYSTERIES.Drop.Remove" aria-label="{{localize 'LORD_OF_THE_MYSTERIES.Drop.Remove'}}">
                <i class="fa-solid fa-trash"></i>
              </button>
            {{else}}
              {{!-- Granted entries can't be removed here; keep the remove button's column so the move buttons line up across rows. --}}
              <span class="drop-entry-spacer" aria-hidden="true"></span>
            {{/if}}
          {{/if}}
        </li>
      {{/each}}
    </ol>
  {{else}}
    <p class="drop-section-empty">{{localize "LORD_OF_THE_MYSTERIES.Drop.Empty"}}</p>
  {{/if}}
</div>
