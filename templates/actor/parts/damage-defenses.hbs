{{!-- Damage reduction, resistance and immunity, in the player and NPC sidebars (helpers/damage-math.mjs has the rules).
      reductionRows / resistanceRows: the saved rows, with their index and their type as a key
      (_prepareDefenseRows in sheets/base-actor-sheet.mjs). Worn armor's reduction is listed read-only. --}}
<div class="stat-box full-width damage-resistance-box damage-reduction-box">
  <label data-tooltip="{{localize 'LORD_OF_THE_MYSTERIES.DamageReduction.Hint'}}">{{localize "LORD_OF_THE_MYSTERIES.DamageReduction.Label"}}</label>
  <ul class="damage-resistance-list">
    {{#each reductionRows as |row|}}
    <li class="damage-resistance-row">
      <select class="damage-resistance-type" name="system.reductions.{{row.index}}.damageType">
        {{selectOptions @root.reductionTypeChoices selected=row.damageType}}
      </select>
      <input type="number" class="damage-resistance-value" name="system.reductions.{{row.index}}.value" value="{{row.value}}" min="0" />
      {{#if @root.editable}}
      <a class="damage-resistance-remove" data-action="removeReduction" data-index="{{row.index}}"
         data-tooltip="LORD_OF_THE_MYSTERIES.GenericButtons.Remove">
        <i class="fas fa-trash"></i>
      </a>
      {{/if}}
    </li>
    {{/each}}
    {{!-- From the worn armor (base-actor.mjs _prepareDamageReduction). Read-only: take the armor off to remove it. --}}
    {{#each system.armorReductionList as |row|}}
    <li class="damage-resistance-row from-armor"
        data-tooltip="{{localize 'LORD_OF_THE_MYSTERIES.Inventory.Armor.FromArmor' name=row.source}}">
      <span class="damage-resistance-type">{{localize row.label}}</span>
      <span class="damage-resistance-value">{{row.value}}</span>
      <i class="damage-resistance-source fa-solid fa-shield-halved"></i>
    </li>
    {{/each}}
  </ul>
  {{#if editable}}
  <button type="button" class="damage-resistance-add-button" data-action="addReduction">
    <i class="fa-solid fa-plus"></i> {{localize "LORD_OF_THE_MYSTERIES.GenericButtons.Add"}}
  </button>
  {{/if}}
</div>

<div class="stat-box full-width damage-resistance-box damage-resistance-only-box">
  <label data-tooltip="{{localize 'LORD_OF_THE_MYSTERIES.DamageResistance.Hint'}}">{{localize "LORD_OF_THE_MYSTERIES.DamageResistance.Label"}}</label>
  <ul class="damage-resistance-list">
    {{#each resistanceRows as |row|}}
    <li class="damage-resistance-row{{#if row.isImmune}} is-immune{{/if}}">
      <select class="damage-resistance-type" name="system.resistances.{{row.index}}.damageType">
        {{selectOptions @root.damageTypeChoices selected=row.damageType}}
      </select>
      <input type="number" class="damage-resistance-value" name="system.resistances.{{row.index}}.value" value="{{row.value}}" min="0"
             {{#if row.isImmune}}readonly{{/if}} />
      <label class="damage-immune" data-tooltip="{{localize 'LORD_OF_THE_MYSTERIES.DamageResistance.ImmuneHint'}}">
        <input type="checkbox" name="system.resistances.{{row.index}}.isImmune" {{checked row.isImmune}} />
        {{localize "LORD_OF_THE_MYSTERIES.DamageResistance.Immune"}}
      </label>
      {{#if @root.editable}}
      <a class="damage-resistance-remove" data-action="removeResistance" data-index="{{row.index}}"
         data-tooltip="LORD_OF_THE_MYSTERIES.GenericButtons.Remove">
        <i class="fas fa-trash"></i>
      </a>
      {{/if}}
    </li>
    {{/each}}
  </ul>
  {{#if editable}}
  <button type="button" class="damage-resistance-add-button" data-action="addResistance">
    <i class="fa-solid fa-plus"></i> {{localize "LORD_OF_THE_MYSTERIES.GenericButtons.Add"}}
  </button>
  {{/if}}
</div>
